---
interface Props {
  titulo: string;
  texto: string;
  estrellas?: number;
  nombre: string;
  ciudad: string;
  imagen: string;
  class?: string;
}

const { titulo, texto, nombre, ciudad, imagen, class: clase = '' } = Astro.props;
---

<div>
  <article class="relative z-10 flex h-[19rem] min-w-[400px] max-w-[500px] flex-col rounded-[0.8rem] rounded-bl-[0px] bg-crema p-7">
    <h3 class="font-duper text-4xl font-bold leading-tight text-azul sm:text-3xl">{titulo}</h3>
    <p class="mt-3 text-xl font-futura text-base font-medium leading-snug text-azul">{texto}</p>
    <div class="mt-auto flex gap-1.5">
      {
        Array.from({ length: 5 }).map(() => (
          <span
            aria-hidden="true"
            class="estrella block size-7"
            style="--estrella: url(/icons/estrella.svg)"
          />
        ))
      }
    </div>
  </article>

  <div class="flex">
    <svg width="60" height="49" viewBox="0 0 60 49" fill="none" xmlns="http://www.w3.org/2000/svg" class="my-[-10px] shrink-0">
      <path
        d="M0 46.1016V2.83871C0 1.27093 1.27093 0 2.83871 0H57.0325C59.7173 0 60.9017 3.38217 58.8035 5.0572L4.60974 48.32C2.75058 49.8042 0 48.4805 0 46.1016Z"
        fill="#FFEDC2"
      />
      <path
        d="M0 46.1016V2.83871C0 1.27093 1.27093 0 2.83871 0H57.0325C59.7173 0 60.9017 3.38217 58.8035 5.0572L4.60974 48.32C2.75058 49.8042 0 48.4805 0 46.1016Z"
        fill="#FFEDC2"
      />
    </svg>
    <div class="my-2 flex items-center gap-3">
      <img src={imagen} alt="" aria-hidden="true" class="size-15 shrink-0 rounded-full bg-azul/10 object-cover" />
      <div class="flex justify-center flex-col gap-0.5">
        <p class="font-futura text-lg font-semibold leading-tight text-vino">{nombre}</p>
        <p class="font-futura text-lg font-normal text-vino">{ciudad}</p>
      </div>
    </div>
  </div>
</div>

<style>
  .estrella {
    background-color: var(--color-aura);
    -webkit-mask-image: var(--estrella);
    mask-image: var(--estrella);
    -webkit-mask-size: contain;
    mask-size: contain;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-position: center;
    mask-position: center;
  }
</style>
