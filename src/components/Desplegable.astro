---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'button'> {
  imagen?: string;
  titulo?: string;
}

const {
  imagen = 'slider1.webp',
  titulo = 'Para los días de playa',
  class: clase = '',
  ...resto
} = Astro.props;
---

{/* absolute + top-0 + h-full: Momento.astro calcula "left" y "width" en px
    para cada uno (ver su script). Antes esto usaba flex-basis en %, pero esa
    transición se ve entrecortada en varios motores; width/left en px son de
    las propiedades más confiables para animar. */}
<button
  type="button"
  data-desplegable
  class:list={[
    // Mobile: barra horizontal, en el flujo normal, de ancho completo. El
    // `absolute` + top-0 de desktop (donde el script le calcula `left` y
    // `width` en px) vuelve recién en md.
    //
    // El ALTO no está acá sino en el <style> de abajo, junto con el de la
    // cápsula abierta. Tenerlo repartido entre una utilidad de Tailwind y una
    // regla del componente es pelearse con la cascada: son dos hojas
    // distintas y termina ganando la que el bundler ponga última, no la más
    // específica. Declarado en un solo lugar, el caso abierto gana siempre.
    'group relative isolate flex w-full shrink-0 cursor-pointer items-center justify-center overflow-hidden',
    'md:absolute md:top-0 md:w-auto',
    clase,
  ]}
  {...resto}
>
  {/* Medida fija y no "cubrir la caja": si la foto se adaptara al tamaño del
      botón, al abrirse se reescalaría y se vería un zoom. Con una medida fija
      la foto nunca cambia de tamaño y el botón solo tapa o destapa una
      porción más grande, como una ventana.
      Cuál es esa medida depende de por dónde crece cada uno: en desktop la
      cápsula se ensancha, así que lo fijo es el ancho (440px, el mismo
      ANCHO_ABIERTO de Momento.astro); en mobile crece a lo alto, así que lo
      fijo es el alto (26vh, el mismo de la barra abierta). */}
  <img
    src={`/images/${imagen}`}
    alt=""
    aria-hidden="true"
    class="pointer-events-none absolute left-0 top-1/2 h-[26vh] w-full -translate-y-1/2 object-cover object-center md:left-1/2 md:top-0 md:h-full md:w-[440px] md:max-w-none md:-translate-x-1/2 md:translate-y-0"
  />

  {/* Tinte azul sobre la foto: 50% en reposo, se apaga del todo al abrirse
      (revela "el color real", o sea la foto sin el velo). Va en un span
      aparte y no como background-color del botón: así se puede animar su
      opacidad sin tocar la imagen de fondo. */}
  <span aria-hidden="true" data-tinte class="pointer-events-none absolute inset-0 bg-[#0071B8]"></span>

  {/* El -rotate-90 —que gira el texto para que se lea de abajo hacia arriba,
      como en la referencia— es solo de desktop, donde la cápsula es vertical.
      En mobile la cápsula es horizontal, así que el título va derecho y un
      poco más grande. whitespace-nowrap en los dos casos, para que ningún
      título se parta en dos líneas. */}
  {/* Tamaño fluido en mobile con tope en 2.6rem, el valor que tenía fijo.
      Importa más acá que en otros lados por el `whitespace-nowrap`: el título
      no puede envolver, así que a tamaño fijo el más largo ("Para los días de
      playa") medía 329px dentro de una tarjeta de 358 y en cualquier pantalla
      más angosta se salía. Al escalar con el ancho, la proporción entre texto
      y tarjeta se mantiene. md:text-6xl intacto. */}
  <span
    data-titulo
    class="relative whitespace-nowrap font-duper text-[clamp(1.5rem,10.5vw,2.6rem)] font-bold text-[#FFEDC2] md:-rotate-90 md:text-6xl"
  >
    {titulo}
  </span>
</button>

<style>
  /* Cápsula cerrada: extremos totalmente redondeados. En mobile la barra es
     horizontal y bastante más baja, así que el radio de desktop la dejaría
     hecha una píldora finita; con la mitad del alto queda redondeada pero sin
     perder la caja.

     Lo que se anima también cambia según el caso: en mobile la cápsula crece
     a lo ALTO (las demás no cambian de tamaño, las empuja el flex de la
     columna), en desktop se ensancha y el script le mueve el `left`. Misma
     curva y misma duración en los dos. */
  [data-desplegable] {
    height: 11vh;
    border-radius: 6vh;
    transition:
      height 550ms cubic-bezier(1, 0, 0.15, 1),
      border-radius 102ms cubic-bezier(1, 0, 0.15, 1);
  }

  /* Abierta en mobile: 26vh contra los 11vh de reposo, la misma proporción
     que el 440/190 de desktop. */
  @media (max-width: 767px) {
    [data-desplegable][data-abierto] {
      height: 26vh;
    }
  }

  @media (min-width: 768px) {
    [data-desplegable] {
      /* En desktop la cápsula ocupa todo el alto del contenedor y lo que
         cambia es el ancho. */
      height: 100%;
      border-radius: 102px;
      transition:
        width 550ms cubic-bezier(1, 0, 0.15, 1),
        left 550ms cubic-bezier(1, 0, 0.15, 1),
        border-radius 102ms cubic-bezier(1, 0, 0.15, 1);
    }
  }

  /* Abierto: mismo estilo de esquina redondeada, pero un radio fijo bastante
     menor en vez de 9999px — a este ancho, 9999px seguiría dibujando una
     cápsula completa (semicírculo arriba y abajo); con un valor fijo chico
     quedan las paredes rectas y solo las cuatro esquinas curvas. */
  [data-desplegable][data-abierto] {
    border-radius: 6vh;
  }

  @media (min-width: 768px) {
    [data-desplegable][data-abierto] {
      border-radius: 102px;
    }
  }

  /* Oscurecido de hover. Va en un ::after y no subiendo la opacidad del
     tinte azul porque son dos cosas con vidas distintas: el tinte se apaga
     del todo al abrirse la cápsula (es lo que revela la foto en su color
     real), y este oscurecido tiene que poder existir sin pelearse con esa
     transición.

     Detrás del título: el ::after no está posicionado y el título sí
     (`relative`), así que el texto le queda por encima sin necesidad de
     z-index. */
  [data-desplegable]::after {
    content: '';
    position: absolute;
    inset: 0;
    background: #000;
    opacity: 0;
    pointer-events: none;
    transition: opacity 250ms ease-out;
  }

  /* Con el dedo no hay hover, así que el oscurecido también lo dispara el
     toque: `:active` vale mientras el botón está apretado, en mouse y en
     pantalla táctil por igual. */
  [data-desplegable]:active::after {
    opacity: 0.18;
  }

  /* El hover, en cambio, solo donde hay puntero de verdad: en pantallas
     táctiles el :hover se queda pegado después del toque. */
  @media (hover: hover) {
    [data-desplegable]:hover::after {
      opacity: 0.18;
    }
  }

  /* Abierta no se oscurece, ni con hover ni con el toque: ahí la gracia es
     ver la foto sin velo. */
  [data-desplegable][data-abierto]:hover::after,
  [data-desplegable][data-abierto]:active::after {
    opacity: 0;
  }

  [data-tinte] {
    opacity: 0.5;
    transition: opacity 450ms cubic-bezier(1, 0, 0.15, 1);
  }

  [data-desplegable][data-abierto] [data-tinte] {
    opacity: 0;
  }

  [data-titulo] {
    opacity: 1;
    transition: opacity 250ms ease-out;
  }

  /* El título se va rápido y sin esperar a que termine de agrandarse el
     contenedor: si se desvaneciera a la misma velocidad se vería el texto
     estirándose feo mientras el botón todavía está creciendo. */
  [data-desplegable][data-abierto] [data-titulo] {
    opacity: 0;
    transition-duration: 150ms;
  }
</style>
