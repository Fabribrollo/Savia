---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'button'> {
  imagen?: string;
  titulo?: string;
}

const {
  imagen = 'slider1.webp',
  titulo = 'Para los días de playa',
  class: clase = '',
  ...resto
} = Astro.props;
---

{/* absolute + top-0 + h-full: Momento.astro calcula "left" y "width" en px
    para cada uno (ver su script). Antes esto usaba flex-basis en %, pero esa
    transición se ve entrecortada en varios motores; width/left en px son de
    las propiedades más confiables para animar. */}
<button
  type="button"
  data-desplegable
  class:list={[
    'group absolute top-0 isolate flex h-full cursor-pointer items-center justify-center overflow-hidden',
    clase,
  ]}
  {...resto}
>
  {/* Ancho fijo (440px, el mismo que ANCHO_ABIERTO en Momento.astro) y no
      bg-cover: con bg-cover, al transicionar el ancho del botón la imagen se
      reescala para seguir cubriendo la caja — eso es el "zoom" que se veía
      al abrir. Con un ancho fijo la foto nunca cambia de tamaño; el botón
      solo tapa o destapa una porción más grande, como una ventana. */}
  <img
    src={`/images/${imagen}`}
    alt=""
    aria-hidden="true"
    class="pointer-events-none absolute left-1/2 top-0 h-full w-[440px] max-w-none -translate-x-1/2 object-cover"
  />

  {/* Tinte azul sobre la foto: 50% en reposo, se apaga del todo al abrirse
      (revela "el color real", o sea la foto sin el velo). Va en un span
      aparte y no como background-color del botón: así se puede animar su
      opacidad sin tocar la imagen de fondo. */}
  <span aria-hidden="true" data-tinte class="pointer-events-none absolute inset-0 bg-[#0071B8]"></span>

  {/* -rotate-90: mismo truco que ya tenía el componente, gira el bloque de
      texto horizontal para que quede leyéndose de abajo hacia arriba, como
      en la referencia. whitespace-nowrap para que ningún título llegue a
      partirse en dos líneas al rotar. */}
  <span
    data-titulo
    class="relative whitespace-nowrap font-duper text-4xl font-bold text-[#FFEDC2] -rotate-90 md:text-6xl"
  >
    {titulo}
  </span>
</button>

<style>
  [data-desplegable] {
    /* Cápsula cerrada: extremos totalmente redondeados. */
    border-radius: 102px;
    transition:
      width 550ms cubic-bezier(1, 0, 0.15, 1),
      left 550ms cubic-bezier(1, 0, 0.15, 1),
      border-radius 102ms cubic-bezier(1, 0, 0.15, 1);
  }

  /* Abierto: mismo estilo de esquina redondeada, pero un radio fijo bastante
     menor en vez de 9999px — a este ancho, 9999px seguiría dibujando una
     cápsula completa (semicírculo arriba y abajo); con un valor fijo chico
     quedan las paredes rectas y solo las cuatro esquinas curvas. */
  [data-desplegable][data-abierto] {
    border-radius: 102px;
  }

  [data-tinte] {
    opacity: 0.5;
    transition: opacity 450ms cubic-bezier(1, 0, 0.15, 1);
  }

  [data-desplegable][data-abierto] [data-tinte] {
    opacity: 0;
  }

  [data-titulo] {
    opacity: 1;
    transition: opacity 250ms ease-out;
  }

  /* El título se va rápido y sin esperar a que termine de agrandarse el
     contenedor: si se desvaneciera a la misma velocidad se vería el texto
     estirándose feo mientras el botón todavía está creciendo. */
  [data-desplegable][data-abierto] [data-titulo] {
    opacity: 0;
    transition-duration: 150ms;
  }
</style>
