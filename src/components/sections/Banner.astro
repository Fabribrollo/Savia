---
import Boton from "../Boton.astro";


---

<section
  id="banner"
  data-hero
  class="relative isolate flex min-h-dvh h-full flex-col overflow-hidden"
>
{/* El fondo va en su propia capa, separado del contenido: así se puede
    animar (scale + opacity) sin que ese transform le pise el texto/botón,
    que están en un div aparte encima. */}
<div
  data-fondo-banner
  aria-hidden="true"
  class="absolute inset-0 -z-10 bg-[url('/images/banner.webp')] bg-cover bg-center"
></div>

{/* flex-1 y no h-full: la <section> define su alto con `min-height`, y los
    porcentajes de `height` solo miden contra un `height` real del padre. Al no
    encontrarlo, `h-full` se resolvía a `auto` y el div quedaba del alto del
    texto. Como la section es flex-col, `flex-1` sí lo estira hasta el fondo. */}
{/* justify-end: el bloque de texto se va al pie de la sección. El separador
    del fondo ocupa la franja de abajo, así que el mb del contenido lo deja
    apoyado por encima de él y no tapado. */}
<div class="flex flex-1 w-full flex-col justify-end">

{/* Este div envuelve título, subtítulo y botón: la entrada y la salida se
    animan sobre él, no sobre las tres piezas por separado. */}
<div data-contenido-banner class="mx-6 mb-20 sm:mx-10 sm:mb-24 md:mb-28">


  {/* Sin la máscara de overflow-hidden ni el partido en letras: el título ya
      no se escribe, entra de una pieza desde la izquierda igual que el
      subtítulo y el botón (ver el script al final del archivo). */}
  {/* Tamaños en clamp y no fijos: con `text-7xl` el título medía 72px en
      cualquier pantalla, así que en un teléfono se partía en un montón de
      renglones y el bloque se iba de alto. El tope de cada clamp es el valor
      que tenían antes (4.5rem = text-7xl, 1.5rem = text-2xl), o sea que de
      ~800px de ancho para arriba se ve exactamente igual que hasta ahora. */}
  <h2
    data-titulo-banner
    class="text-start font-bold text-[#CED500] font-duper max-w-[500px] leading-[1.05]"
    style="font-size: clamp(2.5rem, 10vw, 4.5rem);"
  >
    Cada día tiene un movimiento
  </h2>
  <h5
    data-sub-banner
    class="text-start font-futura text-[#FFEDC2] my-4 font-medium"
    style="font-size: clamp(1.05rem, 4.4vw, 1.5rem);"
  >
    Cada movimiento tiene una Savia.
  </h5>

  {/* `relative` va acá y no en el componente: el círculo del hover se
      posiciona contra el botón, y este no lleva `absolute` como el del hero.
      `self-start` para que el flex-col del contenedor no lo estire a lo ancho. */}
  <Boton
    href="#momento"
    fondo="bg-aura"
    texto="text-[#FFF8E7]"
    tamano="px-6 py-2 text-lg sm:px-10 sm:text-2xl"
    flecha={false}
    data-cta-banner
    class="relative self-start"
  >
    Encontrá tu momento
  </Boton>

</div>
</div>

{/* El separador ya no vive acá: pasó a ser el borde superior de Favorita,
    que lo usa como línea de agua mientras sube y tapa esta sección (ver el
    pin del script y el comentario de Favorita.astro). */}

</section>

<script>
  import { gsap, GOLPE, esperarHero, ScrollTrigger } from '../../scripts/entrada';

  const sinMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const seccion = document.querySelector<HTMLElement>('#banner');
  const contenido = document.querySelector<HTMLElement>('[data-contenido-banner]');
  const fondo = document.querySelector<HTMLElement>('[data-fondo-banner]');

  if (seccion && contenido && !sinMovimiento) {
    const DUR = 1;

    // El fondo arranca un poco más grande y se asienta a su tamaño real —
    // un "Ken Burns" liviano, con GOLPE como todo lo demás de la sección.
    // Sin fade: la opacidad queda en 1 de entrada.
    if (fondo) gsap.set(fondo, { scale: 1.12 });

    esperarHero(() => {
      // ---- PIN: el banner se queda quieto y Favorita lo ahoga -------------
      // Desde que el banner llena la pantalla hasta que su borde inferior
      // llega arriba de todo, la sección queda fija. La sensación es que el
      // scroll "no baja": lo único que se mueve es lo que viene después, o
      // sea Favorita, que sube por encima (z-index) con separador.svg de
      // línea de agua hasta taparlo del todo.
      //
      // pinSpacing:false es lo que hace que no haga falta ningún cálculo: no
      // se agrega recorrido extra al documento, así que el tramo de scroll
      // que se "gasta" tapando el banner es exactamente el alto que la
      // sección ya ocupaba. Por eso el final del pin ('bottom top') coincide
      // solo con el instante en que Favorita termina de cubrirlo, mida lo
      // que mida cada una.
      ScrollTrigger.create({
        trigger: seccion,
        start: 'top top',
        end: 'bottom top',
        pin: true,
        pinSpacing: false,
        // Con scroll rápido el pin se aplica un frame tarde y se ve un salto;
        // esto lo adelanta un poco.
        anticipatePin: 1,
      });

      // Con la tipografía ya cargada: el offset sale de medir el contenido, y
      // sin la fuente definitiva la medida sale mal.
      document.fonts.ready.then(() => {
        // Hasta dónde llega lo que REALMENTE SE VE. No sirve medir las cajas:
        // el subtítulo es un bloque y su caja llega hasta el margen derecho de
        // la sección aunque su texto termine mucho antes, así que dominaba el
        // máximo y mandaba todo el contenido fuera de cuadro sin que asomara
        // nada. Con un Range sobre el contenido de cada hijo se mide el texto
        // en sí; el botón no tiene texto suelto que medir, así que para él
        // vale su caja (que es del tamaño del botón).
        const derechaVisible = (el: Element) => {
          const rango = document.createRange();
          rango.selectNodeContents(el);
          const r = rango.getBoundingClientRect();
          return r.width ? r.right : el.getBoundingClientRect().right;
        };

        const derechaContenido = () => {
          // Se descuenta el `x` que GSAP ya escribió: getBoundingClientRect()
          // incluye el transform, y sin esto el valor se realimenta en cada
          // refresh y el contenido se va corriendo cada vez más lejos.
          const x = gsap.getProperty(contenido, 'x') as number;
          return Math.max(...[...contenido.children].map(derechaVisible)) - x;
        };

        // Desplazamiento completo: el borde derecho del contenido queda justo
        // en x=0, o sea entero fuera de cuadro. Sin asomo.
        const oculto = () => -derechaContenido();

        gsap.set(contenido, { x: oculto });

        // ---- ENTRADA: de 'top 50%' a 'top top' ---------------------------
        // Cierra cuando la sección termina de llenar la pantalla ("cuando se
        // completa el scroll se muestra todo"), pero arranca a mitad de
        // camino y no desde 'top bottom'.
        //
        // El motivo es que el golpe no se sentía: con el rango de un viewport
        // entero, la sección se desplazaba tanto en vertical como el contenido
        // en horizontal, y el movimiento vertical tapaba al horizontal. Con
        // medio viewport el recorrido horizontal pasa a ser el mayor de los
        // dos, y el tramo final de GOLPE llega a moverse varias veces más
        // rápido que el scroll — ahí es donde se lee el golpe.
        //
        // scrub bajo (0.3 y no 0.6) por lo mismo: cuanto más lag, más se
        // suaviza justo la frenada seca que da el efecto.
        gsap
          .timeline({
            defaults: { ease: GOLPE, duration: DUR },
            scrollTrigger: {
              trigger: seccion,
              start: 'top 50%',
              end: 'top top',
              scrub: 0.3,
              invalidateOnRefresh: true,
            },
          })
          // fromTo y no to: con invalidateOnRefresh un `to` relee su arranque
          // del estado actual, y si el refresh cae con el tween resuelto el
          // origen queda en 0 y deja de moverse (mismo problema que documenta
          // Home.astro).
          .fromTo(contenido, { x: oculto }, { x: 0 }, 0);

        // ---- DE-ZOOM DEL FONDO: aparte del resto ------------------------
        // Sale de la timeline de entrada por dos motivos. Uno, el rango: allá
        // son medio viewport (360px) y acá son dos viewports enteros, así que
        // el mismo 1.12 → 1 se reparte en 4 veces más scroll y se siente
        // mucho más lento. Dos, el ease: GOLPE deja el zoom casi congelado y
        // después lo resuelve de un saque, que es justo lo contrario de lo
        // que se busca acá. Con 'none' el de-zoom avanza parejo con el
        // scroll, como corresponde a un Ken Burns.
        gsap.fromTo(
          fondo,
          { scale: 1.12 },
          {
            scale: 1,
            ease: 'none',
            scrollTrigger: {
              trigger: seccion,
              start: 'top bottom',
              end: 'bottom top',
              scrub: 0.6,
              invalidateOnRefresh: true,
            },
          }
        );

        // Sin salida: una vez que el contenido llega a x:0 se queda ahí y
        // acompaña a la sección mientras se scrollea. Al volver hacia arriba,
        // el scrub de la entrada lo revierte solo.
      });
    });
  }
</script>
