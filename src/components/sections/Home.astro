---
import Nav from '../Nav.astro';
import Aura from '../Aura.astro';
import Boton from '../Boton.astro';
import Card from '../Card.astro';

// Los SVG de /icons ya vienen con stroke #FFEDC2 (el crema), que es el color
// que corresponde sobre el círculo azul, así que se usan tal cual como <img>.
const beneficios = [
  {
    titulo: 'Natural por dentro',
    texto: 'Hecha con ingredientes seleccionados para conservar lo mejor de la naturaleza.',
    pos: 'md:left-[13%] md:top-[29%]',
    icono: '/icons/natural.svg',
  },
  {
    titulo: 'Sabores auténticos',
    texto: 'Recetas equilibradas donde cada ingrediente tiene un propósito.',
    pos: 'md:left-[16%] md:top-[56%]',
    icono: '/icons/cereza.svg',
  },
  {
    titulo: 'Fresca en cada sorbo',
    texto: 'Una experiencia liviana que revitaliza desde el primer trago.',
    pos: 'md:right-[13%] md:top-[21%]',
    icono: '/icons/burbujas.svg',
  },
  {
    titulo: 'Siempre con vos',
    texto: 'Desde la mañana hasta el último plan del día, Savia acompaña tu movimiento.',
    pos: 'md:right-[16%] md:top-[48%]',
    icono: '/icons/energia.svg',
  },
];

// Frutas del fondo de la primera sección. `tam` va en vw, sin unidad: lo
// consume `--tam` y el CSS le aplica un piso en px para que en mobile no
// queden diminutas (ver .fruta más abajo).
//
// Los archivos salen de /icons/fondo: son los mismos SVG pero con el color de
// esta sección (#9BA200) ya adentro, más el opacity 0.21 que las deja como
// marca de agua. Si hay que cambiar el color, se regenera esa copia.
const frutas = [
  // Arriba a la izquierda, grande, apoyada contra la L del titular.
  { tipo: 'frutilla', pos: 'left-[3.5%] top-[7%]', tam: 12, giro: -18 },
  // Metida en el borde izquierdo: se sale de cuadro y el overflow la corta.
  { tipo: 'frutilla', pos: 'left-[-6%] top-[46%]', tam: 12.75, giro: 14 },
  // Dos arándanos repartidos en la zona izquierda.
  { tipo: 'arandano', pos: 'left-[21%] top-[36%]', tam: 4.5, giro: -8 },
  { tipo: 'arandano', pos: 'left-[10%] top-[74%]', tam: 5.25, giro: 22 },
  // En el medio del titular, tamaño mediano.
  { tipo: 'frutilla', pos: 'left-[45%] top-[21%]', tam: 7.9, giro: 10 },
  // Zona derecha: tres arándanos y una frutilla, todos medianos.
  { tipo: 'arandano', pos: 'right-[7%] top-[13%]', tam: 4.9, giro: 12 },
  { tipo: 'frutilla', pos: 'right-[10%] top-[33%]', tam: 8.25, giro: -12 },
  { tipo: 'arandano', pos: 'right-[21%] top-[57%]', tam: 4.1, giro: -20 },
  { tipo: 'arandano', pos: 'right-[4%] top-[72%]', tam: 5.25, giro: 6 },
];

// Tercera sección: los 5 títulos se acomodan sobre el arco del domo, en el
// orden en que quedan de izquierda a derecha. El ángulo (en grados, 0 = cima
// del domo) lo asigna el script a partir de la posición en el array.
const arcoBeneficios = [
  { titulo: 'Ingredientes naturales', icono: '/icons/natural.svg' },
  { titulo: 'Bienestar diario', icono: '/icons/bienestar.svg' },
  { titulo: 'Frescura real', icono: '/icons/burbujas.svg' },
  { titulo: 'Sabores auténticos', icono: '/icons/cereza.svg' },
  { titulo: 'Energía para tu día', icono: '/icons/energia.svg' },
];
---

<section
  id="home"
  data-hero
  class="relative isolate flex min-h-dvh flex-col overflow-hidden bg-lima"
>
  <!-- Frutas del fondo. z-0 y primeras en el DOM: quedan detrás del titular
       (z-10), de la botella (z-20) y del aura, que es lo que las tapa en la
       mitad de abajo cuando arranca el scroll.

       Cada fruta son dos spans y no uno: el de afuera es el que mueve GSAP en
       la entrada. Si le animara la `y` directamente a la fruta, GSAP tomaría
       el control de translate/rotate/scale y le escribiría `rotate: none` y
       `scale: none` inline — o sea que se llevaría puestos el giro de cada
       fruta y el crecido del hover, que justamente usan esas dos propiedades
       para no pisarse entre ellas. Separando la caja del dibujo, cada uno se
       queda con lo suyo. La caja no lleva medidas: al ser absoluta se ajusta
       sola al tamaño de la fruta, que sale de --tam (que hereda). -->
  <div data-frutas aria-hidden="true" class="absolute inset-0 z-0">
    {
      frutas.map(({ tipo, pos, tam, giro }) => (
        <span data-fruta-home class:list={['absolute block', pos]} style={`--tam:${tam}`}>
          <img
            src={`/icons/fondo/${tipo}-lima.svg`}
            alt=""
            aria-hidden="true"
            class="fruta block"
            style={`aspect-ratio:1;rotate:${giro}deg`}
          />
        </span>
      ))
    }
  </div>

  <Nav />

  <!-- pointer-events-none: la caja del titular cubre buena parte del hero y
       atajaba el hover de las frutas del fondo aunque el texto sea
       transparente. No es interactivo, así que no pierde nada. -->
  {/* El término preferido del clamp va como `vw + rem` y no como vw solo: con
      un vw puro la misma pendiente tiene que servir para mobile y para
      desktop, y no da — en mobile quedaba en 46px. El sumando fijo levanta el
      piso sin tocar el tamaño de desktop (a 1280px da los mismos ~158px).

      El `min()` de adentro es lo que garantiza el corte "LO NATURAL EN /
      MOVIMIENTO" en cualquier pantalla. Los dos renglones ya están separados
      en el marcado, pero eso solo asegura que haya salto DESPUÉS del "en":
      abajo de ~500px de ancho el propio "Lo natural en" no entraba y se
      partía en dos, quedando tres renglones. El segundo término del min es el
      tamaño más grande al que ese renglón —que es el más largo— entra de una
      pieza: mide 5.8 veces el tamaño de fuente, y el ancho disponible es
      100vw menos el px-4 de los costados; el divisor 6 deja un 3% de margen
      sobre esa medida. En desktop nunca manda (a 1280px daría 208px contra
      los 158 del otro término), así que ahí no cambia nada.

      El piso del clamp baja a 2.5rem por lo mismo: con 3.5rem, abajo de
      ~320px el mínimo pisaba al min() y volvía a partirse. */}
  <h1
    class="pointer-events-none relative z-10 px-4 pt-32 text-center font-duper font-bold uppercase leading-[0.82] tracking-[-0.015em] text-azul md:pt-36"
    style="font-size: clamp(2.5rem, min(10vw + 1.9rem, (100vw - 2rem) / 6), 11.5rem);"
  >
    {/* Cada renglón va dentro de una máscara con overflow-hidden: el texto
        entra deslizándose desde abajo y aparece recortado por su propia línea.
        El py/-my compensa el recorte de los glifos con leading 0.82.
        `whitespace-nowrap`: red de seguridad del cálculo de arriba — si por la
        fuente que sea la medida se corriera un poco, el renglón se sale del
        recorte antes que partirse en dos. */}
    <span class="block overflow-hidden py-[0.06em] -my-[0.06em]">
      <span class="block whitespace-nowrap" data-linea>Lo natural en</span>
    </span>
    <span class="block overflow-hidden py-[0.06em] -my-[0.06em]">
      <span class="block whitespace-nowrap" data-linea>Movimiento</span>
    </span>
  </h1>

  <!-- Aura en capa propia (z-0): va por detrás del titular, la botella por
       delante (z-20). Anclada al centro inferior y corrida hacia abajo, así
       nace del borde de abajo y solo sobresale la parte de arriba del halo. -->
  <div class="pointer-events-none absolute inset-x-0 bottom-0 z-0 flex justify-center">
    {/* translate-y 50% = la mitad del alto de la caja: deja el centro del
        círculo justo sobre el borde inferior, así solo se ve su mitad de
        arriba y el resto queda cortado. */}
    {/* Tres círculos concéntricos. Todos van dimensionados en vw (no en %)
        para que salgan círculos perfectos sin depender de la caja del padre.
        `nucleo` es el radio hasta donde el color se mantiene pleno; de ahí
        hasta `fin` va el degradado. */}
    {/*
      Medidas tomadas de la referencia. Sobre esa imagen el centro cae en
      (300, 327) y el arco blanco tiene radio 292, o sea 585 de diámetro.
      Con ese radio como unidad salen las demás:
        · CED500  -> color pleno hasta r=210, transparente en r=255  (0.872 del blanco)
        · E6EA7F  -> color pleno hasta r=150, transparente en r=215  (0.735 del blanco)
      El disco E6EA7F va encima del CED500: al tapar el centro es lo que
      convierte el disco en anillo, con los dos bordes difuminados.
      Todo en vw para que salgan círculos sin depender de la caja del padre.
    */}
    {/* El corrimiento del 50% lo aplica GSAP (yPercent) y no Tailwind: en la
        tercera sección hay que bajar más el centro del domo, y GSAP no puede
        animar la propiedad `translate` que genera la utilidad. */}
    <div data-halo class="relative aspect-square w-[49vw] max-w-[720px]">
      {/* 2º: CED500. Pleno hasta el 88% del radio: degradado más corto (12%
          del radio en vez de 20%) para que el borde se vea más marcado. */}
      <Aura
        size="min(43vw, 628px)"
        offsetY="0%"
        intensidad={1}
        nucleo="88%"
        fin="100%"
      />

      {/* 1º: color del fondo, encima. Pleno hasta el 70% del radio (150/215). */}
      <Aura
        marca="interna"
        size="min(36vw, 529px)"
        offsetY="0%"
        intensidad={1}
        nucleo="70%"
        fin="100%"
        color="var(--color-aura-suave)"
      />

      {/* 3º y último: solo una línea blanca muy delgada, por fuera de ambos
          círculos. Se centra con inset+margin y no con translate, para que
          GSAP no lo pise al escalarlo. */}
      <span
        aria-hidden="true"
        data-contorno
        class="pointer-events-none absolute inset-0 m-auto h-full w-full rounded-full border border-white/50"
      ></span>
    </div>
  </div>

  <!-- La botella arranca al 45% del alto y se corta contra el borde inferior,
       como en la referencia. -->
  <div class="pointer-events-none absolute inset-x-0 top-[45%] z-20 flex justify-center">
    <div data-escenario class="relative flex w-full justify-center">
      <!-- Este wrapper es el que anima GSAP. La rotación base va en la <img>
           para que el tilt 3D no la pise. -->
      <div data-botella class="relative will-change-transform">
        <!-- rojo-trim.png: el original tiene ~69% de ancho en transparencia,
             lo que hacía imposible dimensionarla con vw. -->
        <!-- El tamaño final de la botella lo fija la etapa 2: 0.86 del alto del
             hero. Con el ancho en vw puro, en mobile 22vw daba 82px, caía al
             piso de min-w (165px) y la etapa 2 tenía que escalarla 1.58 — por
             eso en la primera sección se veía diminuta y en la segunda no.
             32vh es ese mismo tamaño final expresado como ancho
             (0.86 × alto × 0.371 de proporción ≈ 0.32 × alto), así que la
             botella ya nace del tamaño correcto y la escala queda en ~1. El
             max() conserva el comportamiento de desktop, donde manda 22vw. -->
        <img
          src="/images/rojo-trim.webp"
          alt="Botella de jugo Savia sabor rojo"
          width="211"
          height="568"
          data-botella-img
          class="w-[max(22vw,32vh)] max-w-[380px] object-contain drop-shadow-[0_30px_50px_rgba(90,100,20,0.3)]"
        />
      </div>
    </div>
  </div>

  <!-- Aura chica: aparece recién al final del scroll, detrás de la botella
       ya centrada. Va en z-[5]: encima de la estela grande, debajo de la
       botella (z-20). -->
  {/* z-[8]: por encima del domo de la tercera etapa (z-[6]) y por debajo de
      la botella (z-20). Con z-[5] el domo la tapaba y desaparecía. */}
  <div class="pointer-events-none absolute inset-0 z-[8] flex items-center justify-center">
    {/* Ya centrada, la botella mide ~283px de ancho. A 25vw la estela apenas
        asomaba 38px por lado y no se leía; 38vw deja ~130px visibles.
        El núcleo alto mantiene color pleno hasta pasado el borde de la
        botella, en vez de empezar a apagarse detrás de ella. */}
    <div class="relative aspect-square w-[46vw] max-w-[660px]">
      <Aura
        marca="suave"
        size="100%"
        offsetY="0%"
        intensidad={1}
        nucleo="52%"
        fin="100%"
        color="var(--color-aura-suave)"
      />
    </div>
  </div>

  <!-- Tarjetas del estado final -->
  <div data-cards class="pointer-events-none absolute inset-0 z-30">
    {
      beneficios.map(({ titulo, texto, pos, icono }) => (
        <Card titulo={titulo} texto={texto} class={pos}>
          <img slot="icono" src={icono} alt="" aria-hidden="true" class="size-6 object-contain" />
        </Card>
      ))
    }
  </div>

  <!-- Tercera sección: los 5 beneficios apoyados sobre el arco del domo.
       Van en z-[9]: por encima del aura (z-0) y del aura suave (z-[8]), por
       debajo de la botella (z-20). La posición la calcula el script con
       trigonometría sobre el círculo del domo, así que acá no llevan
       coordenadas: solo left/top en 0 y GSAP los mueve con x/y. -->
  <div data-arco id="#beneficios" class="pointer-events-none absolute inset-0 z-[9]">
    {
      arcoBeneficios.map(({ titulo, icono }) => (
        <div
          data-arco-item
          class="absolute left-0 top-0 flex w-[10.5rem] flex-col items-center gap-4 text-center"
        >
          <span class="flex size-24 items-center justify-center rounded-full bg-azul">
            <img src={icono} alt="" aria-hidden="true" class="size-12 object-contain" />
          </span>
          <span class="font-duper text-[2.15rem] font-bold leading-[1.05] tracking-[-0.01em] text-azul">
            {titulo}
          </span>
        </div>
      ))
    }
  </div>

  <Boton href="#productos" class="absolute bottom-12 right-10 z-40 md:bottom-16 md:right-16" data-cta>
    Descubrilas
  </Boton>

</section>

<style>
  /* El SVG se usa de máscara y el color lo pone el background: el archivo
     aporta la silueta, la hoja de estilos aporta el tono. */
  /* Antes esto era un <span> pintado con `background-color` y recortado por
     `mask-image`. Se cambió por un <img> con el color ya adentro del archivo
     (ver /icons/fondo) porque las máscaras son de lo más caro de rasterizar,
     y cada vez que el pin del hero re-arma el DOM el navegador tenía que
     redibujar las nueve de una — eso era el parpadeo del final de la entrada.
     Una imagen se decodifica una sola vez.

     El color y el opacity 0.21 de marca de agua ahora viven en el SVG. */
  .fruta {
    /* El tamaño sale de un número suelto (`--tam`, en vw) y no de un `width`
       inline, para poder ponerle un piso: en mobile 1vw es tan poco que las
       frutas quedaban como manchitas. Con max() manda el vw mientras la
       pantalla sea ancha y, por debajo de ~1000px, pasa a mandar el px — que
       es el mismo número multiplicado, así que la jerarquía de tamaños entre
       frutas se mantiene igual. Sin breakpoint: el cambio de una fórmula a la
       otra ocurre justo donde se cruzan, sin salto. */
    width: max(calc(var(--tam) * 1vw), calc(var(--tam) * 10px));

    /* El contenedor ya no bloquea el puntero, pero cada fruta sí tiene que
       recibirlo para el hover. */
    pointer-events: auto;
    transition:
      scale 320ms ease-out,
      filter 320ms ease-out;
  }

  /* Durante la entrada las frutas suben cruzando por debajo del cursor, y
     cada una que lo pisa dispara el hover de acá abajo: color, escala y
     drop-shadow, con 320ms de transición. Como el tramo rápido de la curva
     cae justo al final, eso es lo que se veía como un parpadeo al terminar la
     animación. Con el puntero apagado hasta que la entrada cierra, no hay
     nada que disparar.

     El selector tiene que ganarle en especificidad al `pointer-events: auto`
     de .fruta: apagarlo en el contenedor no alcanza, porque un hijo que lo
     pide en `auto` lo vuelve a prender igual. El atributo lo pone y lo saca
     el script (ver [data-entrando]), no viene en el marcado: si no, con
     prefers-reduced-motion — que no corre la entrada — no lo sacaría nadie y
     las frutas quedarían muertas para siempre. */
  [data-frutas][data-entrando] .fruta {
    pointer-events: none;
  }

  /* Capa propia y permanente para el bloque de frutas.
     Al terminar la entrada, el pin del hero le escribe un transform al hero,
     y un transform nuevo en un ancestro obliga a redibujar todo lo que tiene
     adentro. Las nueve frutas son máscaras — de lo más caro de rasterizar —
     así que se dibujaban todas juntas en un frame y eso se veía como un
     parpadeo. Con capa propia, ese repintado compone la textura que ya
     existe en vez de rehacerla.
     De paso, la salida por scroll anima justamente este contenedor, así que
     también sale más barata. */
  [data-frutas] {
    will-change: transform;
  }

  /* Muy leve a propósito: son fondo, no un elemento interactivo. Se usa la
     propiedad `scale` y no un transform, así no pisa el `rotate` que cada
     fruta trae en su style inline. El drop-shadow toma la silueta de la
     imagen, así que el brillo sale con la forma de la fruta.
     El aclarado va por `brightness` y no por `background-color`: el color ya
     no lo pone el CSS sino el archivo. */
  .fruta:hover {
    scale: 1.03;
    filter: brightness(1.12) drop-shadow(0 0 10px rgba(206, 213, 0, 0.45));
  }
</style>

<script>
  import gsap from 'gsap';
  import { SplitText } from 'gsap/SplitText';
  import { CustomEase } from 'gsap/CustomEase';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { ScrollToPlugin } from 'gsap/ScrollToPlugin';

  gsap.registerPlugin(SplitText, CustomEase, ScrollTrigger, ScrollToPlugin);

  // cubic-bezier(1, 0, 0.15, 1): casi plana al principio, subida muy empinada
  // en el medio y llegada seca. Es la curva del panel de interacción.
  const GOLPE = CustomEase.create('golpe', 'M0,0 C1,0 0.15,1 1,1');

  const sinMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Pivote vertical del transform de la botella, como fracción de su alto.
  // Lo usan el tilt (para rotar desde ahí) y el centrado por scroll (que tiene
  // que compensarlo, porque con un origen que no es el centro el escalado
  // desplaza el elemento además de agrandarlo).
  const ORIGEN_Y = 0.6;

  // Inclinación de la botella en el hero. Antes era una clase de Tailwind,
  // pero GSAP tiene que poder llevarla a 0 al centrarla en la segunda sección
  // y no puede animar la propiedad `rotate` que genera Tailwind.
  const INCLINACION = -7;
  const botellaImg = document.querySelector<HTMLElement>('[data-botella-img]');
  gsap.set(botellaImg, { rotation: INCLINACION });

  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const botella = document.querySelector<HTMLElement>('[data-botella]');

  const cta = document.querySelector<HTMLElement>('[data-cta]');

  if (!sinMovimiento) {
    const DUR = 1.5;
    // Reparto total del stagger de las letras. Sale de DUR, no se suma: las
    // letras arrancan escalonadas pero todas cierran junto con el resto.
    const REPARTO = 0.25;
    const nav = document.querySelector<HTMLElement>('[data-nav]');

    // Distancias medidas ANTES de mover nada, a partir de la posición real de
    // cada elemento: así quedan justo fuera de cuadro en cualquier viewport.
    const fueraDerecha = cta ? window.innerWidth - cta.getBoundingClientRect().left + 40 : 600;
    const fueraArriba = nav ? -(nav.getBoundingClientRect().bottom + 10) : -120;

    // Cuánto hay que bajar la botella para que quede justo debajo del corte
    // inferior. Va en yPercent y no en y: el tilt del mouse usa `y`, y si
    // ambos escribieran la misma propiedad se pisarían.
    // El margen es mínimo a propósito: cada px de más es recorrido invisible,
    // y es lo que antes comprimía todo el asomarse en los últimos frames.
    let fueraAbajo = 60;
    if (hero && botella) {
      const cajaHero = hero.getBoundingClientRect();
      const cajaBotella = botella.getBoundingClientRect();
      fueraAbajo = ((cajaHero.bottom - cajaBotella.top + 15) / cajaBotella.height) * 100;
    }

    // Scroll bloqueado hasta que termine la entrada. Se aplica ya, en el mismo
    // tick del script, para que no se pueda scrollear durante la espera de las
    // tipografías.
    const raiz = document.documentElement;
    raiz.style.overflow = 'hidden';
    window.scrollTo(0, 0);

    let scrollLiberado = false;
    const liberarScroll = () => {
      if (scrollLiberado) return;
      scrollLiberado = true;
      raiz.style.overflow = '';
      // Las frutas vuelven a recibir el puntero. Va acá y no en el onComplete
      // de la timeline porque a esta función se llega por los dos caminos:
      // la entrada terminando sola, o la red de seguridad saltándola.
      document.querySelector('[data-frutas]')?.removeAttribute('data-entrando');
      // El ScrollTrigger se crea recién acá, con el scroll ya desbloqueado.
      // Si se creara antes mediría el documento sin recorrido y el pin quedaría
      // con start/end viejos.
      montarScroll();
    };

    // Referencia a la timeline de entrada, para poder completarla a mano
    // desde la red de seguridad (ver más abajo). Se llena recién dentro de
    // fonts.ready, así que puede no existir todavía cuando dispare el timeout.
    let entrada: gsap.core.Timeline | undefined;

    // Red de seguridad. El scroll lo destraba el onComplete de la entrada, que
    // corre sobre el ticker de GSAP; y el ticker se duerme cuando la pestaña
    // está en segundo plano. Si la página carga sin foco, la entrada nunca
    // termina y el scroll queda trabado. La entrada dura 1.5s, así que a los
    // 4s ya se puede liberar sin riesgo de cortarla.
    //
    // OJO: acá NO se puede llamar a liberarScroll() directo si la timeline de
    // entrada sigue viva. montarScroll() arma su propia timeline apuntando a
    // los mismos elementos (nav, botella, cta) con tweens sueltos, y GSAP
    // sobreescribe por overwrite cualquier tween previo sobre esas mismas
    // propiedades apenas se crea el nuevo — mata la entrada a mitad de camino
    // y esos elementos quedan congelados donde estaban (casi siempre todavía
    // fuera de cuadro). Las letras del título no pisan nada en montarScroll(),
    // por eso son las únicas que terminan de entrar bien: es la pista de este
    // bug ("solo queda el título, navbar y botella desaparecen").
    //
    // La solución es saltar la entrada al final en vez de abandonarla: con
    // progress(1) todos los tweens resuelven a su valor final al instante, y
    // eso además dispara el propio onComplete (liberarScroll), así que no
    // hace falta llamarlo a mano en ese caso.
    setTimeout(() => {
      if (scrollLiberado) return;
      if (entrada) {
        entrada.progress(1);
      } else {
        // Ni siquiera terminaron de cargar las fuentes: no hay timeline que
        // completar. Se destraba igual, a mano, mostrando todo en su
        // posición final.
        gsap.set('[data-nav]', { y: 0 });
        gsap.set('[data-linea]', { yPercent: 0 });
        gsap.set('[data-botella]', { yPercent: 0 });
        gsap.set('[data-halo]', { y: 0 });
        gsap.set('[data-cta]', { x: 0 });
        gsap.set('[data-fruta-home]', { y: 0 });
        liberarScroll();
      }
    }, 4000);

    // Estado inicial aplicado ya, sin esperar a las fuentes. Si esto se hiciera
    // recién dentro del fonts.ready, todo quedaría a la vista en su posición
    // final durante la carga de la tipografía y se vería el salto al arrancar.
    gsap.set('[data-nav]', { y: fueraArriba });
    gsap.set('[data-linea]', { yPercent: 115 });
    gsap.set('[data-botella]', { yPercent: fueraAbajo });
    gsap.set('[data-cta]', { x: fueraDerecha });

    // Las frutas también arrancan fuera de cuadro: la pantalla empieza vacía.
    // Cada una baja al menos lo necesario para que su borde de arriba quede
    // en el piso del hero, más lo que agregue APERTURA (ver abajo).
    const cajasFruta = gsap.utils.toArray<HTMLElement>('[data-fruta-home]');
    const bajada = (el: HTMLElement) => (hero ? hero.offsetHeight - el.offsetTop : 0);

    // Cuánto conservan las frutas su reparto vertical mientras esperan abajo.
    //
    // Con 0, cada una baja justo lo necesario para que su borde de arriba
    // quede en el corte: todas terminan alineadas en la misma línea, o sea
    // amontonadas en una fila al pie — que es lo que quedaba feo. Con 1 bajan
    // todas lo mismo y suben en bloque, con la composición final intacta,
    // pero entonces todas recorren igual y llegan juntas.
    //
    // 0.7 conserva el 70% del reparto: abajo se las ve repartidas y no en
    // fila, y todavía queda bastante diferencia de recorrido entre la de más
    // abajo y la de más arriba como para que no frenen todas en el mismo
    // frame.
    const APERTURA = 0.7;

    // Se miden una sola vez: leer offsetTop dentro del onUpdate obligaría al
    // navegador a recalcular layout en cada frame.
    const distancias = cajasFruta.map((el) => bajada(el) + APERTURA * el.offsetTop);
    const bajadaMaxima = Math.max(...distancias, 1);
    // Lo único que anima GSAP: cuántos px lleva subido el grupo entero.
    const recorrido = { px: 0 };
    gsap.set(cajasFruta, { y: (i: number) => distancias[i] });

    // ---- PARPADEO DE LAS FRUTAS ----------------------------------------
    // Al terminar la entrada, montarScroll() crea el ScrollTrigger del hero y
    // el pin le escribe un transform AL HERO (más position/left/top/margin).
    // Un transform nuevo en un ancestro le arma un contexto de composición
    // nuevo a todo lo que tiene adentro: las nueve frutas son máscaras, se
    // rasterizan todas juntas en un frame y eso es lo que se veía parpadear.
    // Lo confirmé con un MutationObserver: en el mismo milisegundo en que
    // aparece el pin-spacer, #home pasa de no tener transform a tener
    // translate3d.
    //
    // Igualarle el transform al hero de antemano no alcanza: sea cual sea el
    // valor que le pongamos, el pin después escribe el suyo, y si uno es 2D y
    // el otro 3D la capa se promueve o se degrada igual. Lo que sí corta el
    // problema es que las frutas tengan capa propia y permanente, y eso se
    // pide desde el CSS con `will-change` (ver [data-frutas] en el <style>):
    // con capa propia, cualquier repintado del ancestro compone la que ya
    // está en vez de volver a dibujar las nueve máscaras.
    //
    // Acá queda solo el transform neutro del contenedor, que evita el otro
    // cambio de estado: pasar de `none` a `matrix(...)` cuando montarScroll()
    // crea la timeline del scroll.
    gsap.set('[data-frutas]', { y: 0 });

    // Puntero apagado mientras dura la entrada (ver el CSS de arriba). Se
    // prende acá y no en el marcado para que, sin animación, nunca llegue a
    // apagarse.
    document.querySelector('[data-frutas]')?.setAttribute('data-entrando', '');

    // Se espera a que carguen las tipografías: SplitText mide el texto al
    // partirlo, y con la fuente todavía sin cargar los cortes salen mal.
    document.fonts.ready.then(() => {
      const cortes = gsap.utils
        .toArray<HTMLElement>('[data-linea]')
        // 'words,chars': sin el envoltorio por palabras, cada letra es un
        // inline-block suelto y el navegador corta la línea entre dos letras
        // cualesquiera — en pantallas angostas el título se parte al medio de
        // una palabra. `corte.chars` sigue devolviendo todas las letras.
        .map((linea) => new SplitText(linea, { type: 'words,chars' }));

      // Orden diagonal: entran primero las letras de arriba a la izquierda y
      // el frente avanza hacia abajo a la derecha.
      const letras = cortes
        .flatMap((corte) => corte.chars as HTMLElement[])
        .sort((a, b) => {
          const ra = a.getBoundingClientRect();
          const rb = b.getBoundingClientRect();
          return ra.left + ra.top - (rb.left + rb.top);
        });

      // Cada elemento arranca completamente fuera de cuadro: al principio solo
      // se ve el fondo. Con expo.in el avance visual es casi nulo durante los
      // primeros dos tercios, así que recién sobre el final asoman y entran
      // de golpe.
      // El estado oculto pasa de la línea entera a cada letra dentro del mismo
      // tick sincrónico, así no se renderiza ningún frame intermedio.
      gsap.set(letras, { yPercent: 115, x: -22 });
      gsap.set('[data-linea]', { yPercent: 0 });

      // Todos arrancan en 0 y cierran a la vez. expo.in deja el elemento casi
      // quieto y resuelve el recorrido sobre el final: ese es el golpe.
      entrada = gsap
        .timeline({ defaults: { ease: GOLPE, duration: DUR }, onComplete: liberarScroll })
        .to('[data-nav]', { y: 0 }, 0)
        // Mismo ease y mismo cierre que el resto. `amount` reparte el total
        // del escalonado entre todas las letras en vez de fijarlo por letra,
        // así el desfasaje no crece con la cantidad de caracteres: la L asoma
        // primero y el golpe final cae junto para todas.
        .to(
          letras,
          { yPercent: 0, x: 0, duration: DUR - REPARTO, stagger: { amount: REPARTO } },
          0
        )
        .to('[data-botella]', { yPercent: 0 }, 0)
        // Las frutas suben con la botella: todas arrancan en el mismo
        // instante y se mueven a la misma velocidad.
        //
        // Para eso lo que se anima no son las frutas sino UN recorrido
        // compartido: un solo número que avanza con la curva de la entrada, y
        // cada fruta se planta en lo que le falta (max(0, ...) la frena en su
        // lugar cuando llega). Así todas se mueven exactamente lo mismo en
        // cada frame — misma velocidad — y la que estaba más abajo llega
        // antes y se queda quieta; la de más arriba cierra en DUR, junto con
        // la botella.
        //
        // Se hace a mano y no con `modifiers` porque ahí las frutas no
        // interpolaban: se quedaban clavadas en su valor inicial y saltaban a
        // destino de una.
        //
        // El intento anterior (duración proporcional a cada distancia) daba
        // otra cosa: al escalar la curva a tiempos distintos, en un mismo
        // instante cada fruta estaba en un tramo distinto del ease, así que
        // las de recorrido corto salían disparadas mientras las largas
        // todavía no se habían movido.
        .to(
          recorrido,
          {
            px: bajadaMaxima,
            duration: DUR,
            onUpdate: () => {
              for (let i = 0; i < cajasFruta.length; i++) {
                gsap.set(cajasFruta[i], { y: Math.max(0, distancias[i] - recorrido.px) });
              }
            },
          },
          0
        )
        // Las dos auras y el contorno, todos hijos de [data-halo]: mismo
        // ease y misma duración (los defaults de la timeline) y misma
        // posición 0 que la botella, así entran exactamente al mismo ritmo.
        .to('[data-halo]', { y: 0 }, 0)
        .to('[data-cta]', { x: 0 }, 0);
    });
  }

  // Mouse tilt 3D: la botella sigue al cursor sobre los ejes X e Y.
  if (hero && botella && !sinMovimiento) {
    const TILT_MAX = 14; // grados
    const DESPLAZAMIENTO = 18; // px

    gsap.set(botella, { transformPerspective: 900, transformOrigin: 'center 60%' });

    // quickTo mantiene un solo tween vivo por propiedad: mucho más barato
    // que crear un gsap.to() en cada pointermove.
    const suave = { duration: 0.9, ease: 'power3.out' };
    const aRotY = gsap.quickTo(botella, 'rotationY', suave);
    const aRotX = gsap.quickTo(botella, 'rotationX', suave);
    const aX = gsap.quickTo(botella, 'x', suave);
    const aY = gsap.quickTo(botella, 'y', suave);

    hero.addEventListener('pointermove', (evento) => {
      const caja = hero.getBoundingClientRect();
      // -0.5 .. 0.5 respecto del centro del hero
      const nx = (evento.clientX - caja.left) / caja.width - 0.5;
      const ny = (evento.clientY - caja.top) / caja.height - 0.5;

      aRotY(nx * TILT_MAX * 2);
      aRotX(-ny * TILT_MAX);
      aX(nx * DESPLAZAMIENTO);
      aY(ny * DESPLAZAMIENTO * 0.6);
    });

    hero.addEventListener('pointerleave', () => {
      aRotY(0);
      aRotX(0);
      aX(0);
      aY(0);
    });
  }

  // ---------------------------------------------------------------------
  // Transición por scroll: el hero queda pineado y muta al estado final.
  // Nav y titular se van hacia arriba, la botella se centra, la estela crece
  // hasta cubrir el fondo y entran el aura suave y las tarjetas.
  // ---------------------------------------------------------------------
  const aura = document.querySelector<HTMLElement>('[data-aura="aura"]');
  const auraSuave = document.querySelector<HTMLElement>('[data-aura="suave"]');
  const contorno = document.querySelector<HTMLElement>('[data-contorno]');
  const auraInterna = document.querySelector<HTMLElement>('[data-aura="interna"]');
  const titular = document.querySelector<HTMLElement>('h1');
  const navBarra = document.querySelector<HTMLElement>('[data-nav]');
  const frutas = document.querySelector<HTMLElement>('[data-frutas]');
  const tarjetas = gsap.utils.toArray<HTMLElement>('[data-card]');
  const halo = document.querySelector<HTMLElement>('[data-halo]');
  const arcoItems = gsap.utils.toArray<HTMLElement>('[data-arco-item]');

  // El centro del halo apoyado sobre el borde inferior del hero. Lo escribe
  // GSAP y no una clase, porque la tercera sección lo baja todavía más.
  gsap.set(halo, { yPercent: 50 });

  // Estado de entrada del halo — o sea de las DOS auras y el contorno, que
  // son sus hijos, así que se mueven los tres juntos con un solo tween.
  //
  // Con el yPercent 50 de arriba, la mitad de arriba del halo asoma por
  // encima del borde inferior del hero; bajarlo otro medio alto lo deja
  // exactamente a ras del borde, o sea sin nada a la vista. Desde ahí sube
  // hasta y:0 en la timeline de entrada, con el mismo ease, la misma
  // duración y la misma posición (0) que la botella.
  //
  // Va en `y` y no en `yPercent` porque el yPercent ya está ocupado por el
  // centrado de arriba, y porque la tercera sección también anima `y` — al
  // terminar la entrada este queda en 0, así que ese tween arranca limpio.
  if (halo && !sinMovimiento) gsap.set(halo, { y: () => halo.offsetHeight / 2 });

  // Los beneficios del arco no existen hasta la tercera sección.
  gsap.set(arcoItems, { opacity: 0, xPercent: -50 });

  // El aura suave ya existe en el hero: arranca calzada encima del círculo
  // interno del anillo (mismo centro, mismo diámetro) para que se lean como uno
  // solo, y de ahí en más viaja con la botella. Antes aparecía de la nada a
  // mitad del scroll.
  // La opacidad de partida es parcial porque abajo está el `interna`: sumadas
  // dan la densidad del hero, y a medida que ese se apaga, esta sube a 1.
  const escalaLuzHero = () =>
    auraInterna && auraSuave ? auraInterna.offsetWidth / auraSuave.offsetWidth : 0.78;
  // El aura suave está centrada en el viewport; el anillo del hero tiene su
  // centro sobre el borde de abajo. La diferencia es medio alto del hero.
  const bajarLuzAlHero = () => (hero ? hero.offsetHeight / 2 : 0);

  gsap.set(auraSuave, { opacity: 0.55, scale: escalaLuzHero(), y: bajarLuzAlHero() });

  // ---- BENEFICIOS EN MOBILE: DE LA FILA DE ABAJO A LA PILA -------------
  // En desktop las cuatro tarjetas tienen su lugar fijo (dos a cada lado, con
  // el `pos` que les pasa el marcado) y solo suben. En mobile no entran así:
  // acá se las ve primero abajo, en fila y encimadas como un mazo, y de a una
  // se van acomodando en una pila centrada y compacta.
  //
  // Se evalúa una sola vez: lo que cambia entre un caso y el otro no son los
  // valores sino la FORMA de la animación (en mobile son dos etapas con
  // escalonado; en desktop, un solo tween parejo), y eso no es algo que se
  // pueda recalcular en un refresh.
  const esMovil = window.matchMedia('(max-width: 767px)').matches;

  // Dónde espera cada una antes de acomodarse: en fila, derechas y alineadas
  // igual que en la pila final, solo que abajo y bien juntas — se pisan entre
  // ellas y de cada una asoma nada más que el encabezado, como un mazo. No
  // llevan ni corrimiento horizontal ni giro: lo único que cambia entre el
  // estado de espera y el final es la altura.
  const FILA_ARRANQUE = 0.58; // dónde empieza la fila, en fracción del alto
  const FILA_PASO = 0.075; // cuánto baja cada una respecto de la anterior
  const filaY = (i: number) =>
    hero ? hero.offsetHeight * (FILA_ARRANQUE + FILA_PASO * i) : 0;

  // Y dónde esperan antes de eso, mientras se ve la primera sección: abajo del
  // corte del hero, ya en formación. Estando fuera de cuadro no hace falta
  // apagarlas, y es justamente lo que les permite entrar subiendo en vez de
  // apareciendo.
  const FUERA_ABAJO = 1.08;

  // Posición final de cada una en la pila: una debajo de la otra, pegadas
  // (HUECO fijo y chico) y con el bloque entero centrado en la pantalla. Se
  // mide en el momento (no es una constante) porque cada tarjeta tiene su
  // propio alto según cuánto texto lleve.
  const HUECO = 14;

  // Las tarjetas son de la segunda sección y no tienen que verse durante la
  // entrada. En desktop eso se resuelve apagándolas (la opacidad la enciende
  // el scroll, ver montarScroll); en mobile alcanza con dejarlas debajo del
  // corte, que es lo que después les permite entrar subiendo.
  gsap.set(tarjetas, {
    opacity: esMovil ? 1 : 0,
    y: () => window.innerHeight * (esMovil ? FUERA_ABAJO : 0.4),
  });

  // Cuánto tiene que subir el conjunto para que la última tarjeta —la que
  // queda más abajo— termine fuera de cuadro por arriba.
  const salidaArriba = () =>
    Math.max(
      ...tarjetas.map(
        (el, i) => el.offsetTop + (esMovil ? pila()[i] : 0) + el.offsetHeight + 40
      )
    );

  const pila = () => {
    const alto = hero ? hero.offsetHeight : 0;
    const alturas = tarjetas.map((t) => t.offsetHeight);
    const total =
      alturas.reduce((a, b) => a + b, 0) + HUECO * (tarjetas.length - 1);
    let y = Math.max(alto * 0.03, (alto - total) / 2);
    return alturas.map((h) => {
      const actual = y;
      y += h + HUECO;
      return actual;
    });
  };

  // El ScrollTrigger del hero, para poder tocarle el scrub en los saltos de
  // ancla (ver más abajo). Se llena recién al montarlo.
  let disparadorHero: ScrollTrigger | undefined;

  // Se declara como función (no como const) para poder llamarla desde el
  // onComplete de la entrada, que está más arriba en el archivo.
  function montarScroll() {
    if (!aura || !hero || !botella) return;

    // El degradé es sólido hasta el 46% del radio y se apaga al 72%. Para que
    // el color llegue a las esquinas hay que escalar tomando ese tramo sólido
    // como referencia, no el diámetro completo del elemento.
    const TRAMO_SOLIDO = 0.5;
    // Hasta dónde llega el color pleno del aura CED500, en fracción del radio
    // (el `nucleo="88%"` con el que se instancia en el marcado). El 12% que
    // sobra es degradado, así que no sirve para cubrir.
    const NUCLEO_CED = 0.88;
    // Cuánto del alto del hero ocupa la botella una vez centrada.
    const ALTO_FINAL = 0.86;

    // offsetWidth/offsetHeight no se ven afectados por el transform, así que
    // siguen sirviendo de base aunque el tween ya haya escalado el elemento.
    const escalaBotella = () => (hero.offsetHeight * ALTO_FINAL) / botella.offsetHeight;

    // La botella cuelga de `top-45%`. Para centrarla hay que subirla la
    // diferencia entre ese anclaje y el centro real, expresada en yPercent:
    // el tilt del mouse usa `y`, y si ambos escribieran lo mismo se pisarían.
    const centrarBotella = () => {
      const alto = botella.offsetHeight;
      const escala = escalaBotella();
      const arribaAhora = hero.offsetHeight * 0.45;
      // Con el pivote en ORIGEN_Y, escalar corre el tope: top' = top + f·H·(1−s).
      // Sin ese término la botella queda por encima del centro.
      const centroTrasEscalar =
        arribaAhora + ORIGEN_Y * alto * (1 - escala) + (alto * escala) / 2;
      return ((hero.offsetHeight / 2 - centroTrasEscalar) / alto) * 100;
    };

    // ----- Tercera sección -------------------------------------------------
    // El aura cuelga del borde de arriba: tapa todo el ancho y baja hasta el
    // 70% del alto en su punto más bajo (el centro).
    const ALCANCE_DOMO = 0.73;
    // Ancho que el casquete tiene que cubrir, en veces el de la ventana. Más
    // de 1 agranda el círculo: el arco se aplana y los costados bajan, así el
    // aura se ve más ancha aunque llegue a la misma altura en el centro.
    const ENSANCHE = 1.18;
    // Dónde termina la botella una vez subida: mostrando de la mitad para
    // abajo, bien adentro del aura.
    const FONDO_BOTELLA = 0.62;
    // Cuánto se meten los iconos hacia adentro del borde del aura.
    const RETRO_ICONO = -74;
    // Posición horizontal de cada beneficio, como fracción del ancho. La altura
    // sale del arco. Se reparten por x y no por ángulo: al ensanchar el aura el
    // radio crece, y con ángulos fijos los de los extremos se iban de pantalla.
    const REPARTO_X = [0.115, 0.305, 0.5, 0.695, 0.885];

    // El aura es un círculo con el centro por encima del borde superior. Para
    // que tape todo el ancho, la cuerda a la altura de ese borde tiene que
    // medir W: de ahí sale cuánto hay que levantar el centro.
    //   media cuerda = √(R² − d²) = √(a² + 2ad) = W/2   con R = d + a
    const domo = () => {
      // innerWidth y no offsetWidth: con la barra de scroll presente el hero
      // mide unos px menos, y el aura tiene que cubrir hasta el borde real.
      // +48 de margen: el círculo está centrado en el ancho del hero pero tiene
      // que cubrir hasta el borde de la ventana, que es unos px más ancho.
      const ancho = (Math.max(hero.offsetWidth, window.innerWidth) + 48) * ENSANCHE;
      const alto = hero.offsetHeight;
      const visible = ALCANCE_DOMO * alto; // hasta dónde baja el casquete
      const hundido = Math.max(0, ((ancho * ancho) / 4 - visible * visible) / (2 * visible));
      return { hundido, radio: hundido + visible, cx: hero.offsetWidth / 2, cy: -hundido };
    };

    // El aura se escala desde su radio propio hasta el radio del domo.
    const escalaDomo = () => domo().radio / (aura.offsetWidth / 2);

    // Subida de la botella, en yPercent, respecto de su alto sin escalar.
    // Ya centrada su base queda en H/2 + (alto·escala)/2; hay que llevarla a
    // FONDO_BOTELLA·H.
    const subirBotella = () => {
      const alto = hero.offsetHeight;
      const base = alto / 2 + (botella.offsetHeight * escalaBotella()) / 2;
      return centrarBotella() - ((base - alto * FONDO_BOTELLA) / botella.offsetHeight) * 100;
    };

    // La luz chica sigue a la botella, pero centrada en el tramo que queda a
    // la vista (0 → FONDO_BOTELLA·H) y no en la botella entera: si copiara el
    // desplazamiento completo se iría por arriba del cuadro.
    const subirLuz = () => -(hero.offsetHeight * (0.5 - FONDO_BOTELLA / 2));

    // Altura de reposo del beneficio `i` sobre el arco: puro cálculo geométrico,
    // sin leer nada que el propio GSAP ya haya escrito. Lo usan tanto la
    // posición inicial (colocarArco) como el "to" de la entrada: si en cambio
    // la entrada leyera la posición ya aplicada, se pisaría con su propio punto
    // de partida y el beneficio dejaría de moverse (el mismo problema que ya
    // dio la luz y el botón con `invalidateOnRefresh`).
    const alturaArco = (i: number) => {
      const { radio, cx, cy } = domo();
      const x = REPARTO_X[i] * hero.offsetWidth;
      const dx = x - cx;
      // Altura del borde del aura en esa x, menos lo que se mete hacia
      // adentro. Se ancla por el centro del círculo azul y no por el centro
      // del item: los títulos ocupan distinta cantidad de renglones y centrar
      // la caja entera dejaría los círculos desalineados respecto del arco.
      const borde = cy + Math.sqrt(Math.max(0, radio * radio - dx * dx));
      const disco = arcoItems[i].firstElementChild as HTMLElement;
      return borde - RETRO_ICONO - disco.offsetHeight / 2;
    };

    // Cuándo entran los cinco beneficios. Va como constante porque la etapa
    // siguiente —el giro del carrusel en mobile— tiene que arrancar justo
    // después de que terminan de acomodarse, y así se mueven las dos juntas
    // con tocar un solo número.
    const ENTRADA_ARCO = 1.75;

    // ---- CARRUSEL DEL ARCO EN MOBILE -----------------------------------
    // En desktop los cinco beneficios entran a la vez, repartidos a lo ancho
    // del arco. En una pantalla de teléfono no hay lugar para eso, así que se
    // usa el mismo arco pero como un carrusel: el círculo gira y los va
    // pasando de a uno por la cima, con los vecinos asomando cortados por los
    // bordes.
    //
    // `giro.i` es la posición del carrusel en unidades de beneficio: 0 = el
    // primero en la cima, 2.5 = a mitad de camino entre el tercero y el
    // cuarto. Es lo único que anima el scroll; de traducir eso a coordenadas
    // se encarga colocarArco().
    const giro = { i: 0 };

    // Separación entre dos beneficios consecutivos, en fracción del ancho de
    // pantalla. Con 0.5 el de al lado queda cortado por el borde —se ve que
    // hay más— y todavía no se superpone con el del centro: el bloque mide
    // 10.5rem (168px) y medio ancho de pantalla son ~195px.
    const SEPARACION = 0.5;

    // Esa separación, pasada a ángulo sobre el círculo del domo. Como el radio
    // es enorme comparado con la pantalla (el domo es un casquete muy chato),
    // el ángulo es chiquito y el recorrido se lee casi horizontal, con apenas
    // la caída del arco en los costados — que es justo el efecto buscado.
    const pasoAngular = (radio: number) =>
      Math.asin(Math.min(1, (SEPARACION * hero.offsetWidth) / radio));

    // El alto al que queda un beneficio en el carrusel, para poder usarlo como
    // destino de la entrada sin repetir la cuenta.
    const alturaCarrusel = (i: number) => {
      const { radio, cy } = domo();
      const borde = cy + radio * Math.cos((i - giro.i) * pasoAngular(radio));
      const disco = arcoItems[i].firstElementChild as HTMLElement;
      return borde - RETRO_ICONO - disco.offsetHeight / 2;
    };

    // Los beneficios se apoyan sobre el arco: proyección polar desde el centro
    // del domo. Se recalcula en cada refresh de ScrollTrigger (resize incluido)
    // y, en mobile, en cada frame del giro.
    const colocarArco = () => {
      // Una sola medición del domo para los cinco: adentro del onUpdate esto
      // corre en cada frame y `domo()` lee layout.
      const { radio, cx, cy } = domo();
      const paso = esMovil ? pasoAngular(radio) : 0;

      arcoItems.forEach((item, i) => {
        const disco = item.firstElementChild as HTMLElement;

        if (!esMovil) {
          gsap.set(item, { x: REPARTO_X[i] * hero.offsetWidth, y: alturaArco(i) });
          return;
        }

        // Polar: el ángulo lo da la distancia al que está en la cima, y de ahí
        // salen las dos coordenadas. La `x` va sin corregir por el ancho del
        // item: ya lleva un `xPercent: -50` puesto más arriba, que es lo que
        // lo centra sobre su coordenada. Restarle además medio ancho acá lo
        // corría medio bloque a la izquierda.
        const angulo = (i - giro.i) * paso;
        const x = cx + radio * Math.sin(angulo);
        const borde = cy + radio * Math.cos(angulo);
        gsap.set(item, { x, y: borde - RETRO_ICONO - disco.offsetHeight / 2 });
      });
    };
    colocarArco();
    ScrollTrigger.addEventListener('refresh', colocarArco);

    const lineaHero = gsap
      .timeline({
        // Mismo ease que la entrada: arranca lento y resuelve sobre el final.
        // Con scrub esto no es una curva de tiempo sino de scroll — el avance
        // por píxel scrolleado deja de ser lineal.
        defaults: { ease: GOLPE },
        scrollTrigger: {
          trigger: hero,
          start: 'top top',
          // No hay contenido debajo todavía: el pin es lo que genera el
          // recorrido de scroll. Al agregar secciones sigue funcionando igual.
          //
          // En mobile hace falta más: la timeline crece por el carrusel de
          // beneficios (cinco paradas con sus pausas) y si el recorrido no
          // acompaña, cada salto se resolvería en un puñado de píxeles. Con
          // 700% las etapas de antes conservan más o menos el mismo ritmo que
          // en desktop y cada salto del carrusel ocupa media pantalla de
          // scroll — suficiente para leerlo sin que se haga largo.
          end: esMovil ? '+=700%' : '+=440%',
          // Más alto = el scroll arrastra la animación con más inercia.
          scrub: 1.4,
          pin: true,
          // Recalcula escalas y distancias al redimensionar.
          invalidateOnRefresh: true,
        },
      })
      // El halo ya no es un círculo: hay que cubrir ancho y alto por separado
      // y quedarse con el factor mayor, o el eje corto deja esquinas sin pintar.
      .to(
        [aura, contorno, auraInterna].filter(Boolean) as HTMLElement[],
        {
          scale: () =>
            Math.max(
              hero.offsetWidth / (aura.offsetWidth * TRAMO_SOLIDO),
              // El vertical lleva la corrección por el núcleo: el aura queda
              // centrada sobre el borde INFERIOR del hero, así que para tapar
              // la pantalla su color pleno tiene que llegar a un radio igual
              // al alto entero, y el pleno termina en NUCLEO_CED del radio.
              // Sin esto, en mobile —donde manda el alto, no el ancho— el
              // color se quedaba a ~100px del borde de arriba y esa franja
              // mostraba el fondo de atrás. En desktop no cambia nada: ahí el
              // término del ancho sigue siendo el mayor de los dos.
              hero.offsetHeight / (aura.offsetHeight * TRAMO_SOLIDO * NUCLEO_CED)
            ),
          duration: 1,
        },
        0
      )
      // La estela vive al 72% en el hero para no taparlo, pero el fondo de la
      // segunda sección tiene que ser #CED500 exacto: con opacidad parcial
      // quedaría mezclado con el lima de abajo.
      .to(aura, { opacity: 1, duration: 0.6 }, 0)
      // El contorno y el círculo interno se apagan durante la expansión: si
      // escalaran visibles, el interno (#E6EA7F) terminaría cubriendo el centro
      // y el fondo de la segunda sección no quedaría en #CED500.
      // Ease lineal y no GOLPE: con la curva del resto, el anillo del hero se
      // apagaba entero entre el 10% y el 20% del recorrido y el corte con la
      // primera sección se notaba. Lineal y estirado, el anillo se disuelve al
      // mismo ritmo con el que el disco crece.
      .to(
        [contorno, auraInterna].filter(Boolean) as HTMLElement[],
        { opacity: 0, duration: 0.62, ease: 'none' },
        0.04
      )
      .to(navBarra, { y: () => -(navBarra!.getBoundingClientRect().height + 60), opacity: 0, duration: 0.45 }, 0)
      .to(titular, { yPercent: -140, opacity: 0, duration: 0.5 }, 0)
      // Las frutas son fondo de la primera sección nada más: a partir de acá
      // la segunda sección ya tiene su propio fondo (el aura CED500 llenando
      // todo), y se verían pisando ese color.
      //
      // Se van hacia arriba con el mismo gesto que el titular y no solo
      // apagándose: misma distancia (1.4 veces el alto del titular, que es
      // exactamente lo que significa su yPercent:-140), misma duración y la
      // misma curva por defecto de la timeline. Al medirse contra el titular
      // en vez de contra un número suelto, los dos siguen viajando igual si
      // mañana cambia el cuerpo del título.
      //
      // fromTo y no to: con invalidateOnRefresh un `to` relee su origen del
      // estado actual, y si el refresh cae con la timeline resuelta el
      // arranque queda en el destino y las frutas dejan de moverse (mismo
      // motivo que documenta la luz, más abajo).
      // El apagado va junto con el viaje, en el mismo tween: antes era lineal
      // y más corto (0.4), pensado para cuando las frutas no se movían. Con
      // esa curva quedaban en un 20-40% de opacidad justo cuando arranca el
      // tramo rápido de GOLPE — y como los SVG ya traen un opacity 0.21
      // adentro, el movimiento pasaba a ser invisible. Con la curva del
      // titular se mantienen a la vista mientras suben y se apagan sobre el
      // final, que es cuando el aura CED500 ya está por llenar la pantalla.
      .fromTo(
        frutas,
        { y: 0, opacity: 1 },
        { y: () => -((titular?.offsetHeight ?? 0) * 1.4), opacity: 0, duration: 0.5 },
        0
      )
      .to(botella, { yPercent: centrarBotella, scale: escalaBotella, duration: 1 }, 0)
      // En la segunda sección la botella va derecha.
      .to(botellaImg, { rotation: 0, duration: 1 }, 0)
      // La luz acompaña a la botella durante todo el recorrido, con la misma
      // duración y curva que ella: sube del borde de abajo al centro mientras
      // crece. Sin esto aparecía recién sobre el final y se leía como un
      // elemento nuevo en vez de como el mismo halo que venía del hero.
      // fromTo y no to: con `invalidateOnRefresh` un `to` vuelve a leer su
      // valor de partida del estado actual, y si el refresh cae con la
      // timeline al final el arranque queda en y:0 y la luz deja de moverse.
      // Con el origen declarado (y como función, para el resize) sobrevive.
      .fromTo(
        auraSuave,
        { y: bajarLuzAlHero, scale: escalaLuzHero },
        { y: 0, scale: 1, duration: 1 },
        0
      )
      // La opacidad sube lineal, al mismo ritmo con el que se apaga el círculo
      // interno del anillo: entre los dos la densidad se mantiene pareja.
      .fromTo(auraSuave, { opacity: 0.55 }, { opacity: 1, duration: 0.62, ease: 'none' }, 0.04)
      // Las tarjetas suben durante TODO el recorrido, sin tocar la opacidad:
      // están siempre presentes y llegan a su lugar junto con el resto.
      // `amount` reparte el escalonado total, así el conjunto cierra en 1.
      //
      // fromTo y no to: con `invalidateOnRefresh` el tween vuelve a leer su
      // valor de partida del estado actual del elemento, y si ya llegó a y:0
      // el arranque queda en 0 y la tarjeta deja de moverse. Declarando el
      // origen explícito (y como función, para que se recalcule al redimensionar)
      // el recorrido sobrevive a cualquier refresh.

      // ----- Etapa 3 ------------------------------------------------------
      // Arranca en 1.05, apenas después de que cierra la segunda sección, y
      // ocupa otra unidad de tiempo: con end en +=440% el recorrido queda
      // repartido más o menos por mitades entre las dos transiciones.
      //
      // El aura no se apaga ni se reemplaza: es la misma que venía llenando
      // el fondo, que se encoge hasta el tamaño del domo.
      .to(aura, { scale: escalaDomo, duration: 1 }, 1.05)
      // El centro del círculo sube por encima del borde superior: el aura pasa
      // de estar apoyada abajo a colgar de arriba, y lo que queda a la vista es
      // un casquete ancho y chato en vez de una burbuja.
      // El yPercent 50 del halo ya aporta media caja, así que `y` solo tiene
      // que descontar el alto del hero más lo que se levanta el centro.
      .to(halo, { y: () => -(hero.offsetHeight + domo().hundido), duration: 1 }, 1.05)
      // La botella sube hasta dejar a la vista solo su mitad de abajo.
      .to(botella, { yPercent: subirBotella, duration: 1 }, 1.05)
      .to(auraSuave, { y: subirLuz, duration: 1 }, 1.05)
      // Las tarjetas de la segunda sección se van hacia arriba, sin fade: se
      // las lleva el scroll fuera de cuadro como a un contenido más de la
      // sección, en vez de desvanecerse en el lugar.
      //
      // Todas suben LA MISMA distancia: la que necesita la de más abajo para
      // terminar arriba del borde. Calcularle a cada una su propio recorrido
      // era lo intuitivo, pero entonces la de abajo viaja más que la de
      // arriba en el mismo tiempo y la pila se va comprimiendo mientras sale.
      // Con una distancia única, el conjunto se va tal como está.
      .to(
        tarjetas,
        {
          y: (i: number) => (esMovil ? pila()[i] : 0) - salidaArriba(),
          duration: 0.5,
        },
        1.05
      )
      // El "Descubrilas" es de las dos primeras secciones: se va por donde vino.
      // offsetLeft y no getBoundingClientRect: no lo afecta el transform, así
      // que la distancia sale bien aunque se recalcule con el tween a medias.
      .to(cta, { x: () => window.innerWidth - cta!.offsetLeft + 40, duration: 0.5 }, 1.05)
      // Los beneficios entran desde abajo con el mismo GOLPE del resto (ease
      // por defecto de la timeline). Arrancan todos a la misma altura: justo
      // por debajo del borde inferior del hero (que en esta etapa ocupa toda
      // la pantalla), así entran literalmente desde fuera de cuadro sin
      // importar en qué punto del arco termine cada uno. El "to" es la misma
      // altura de reposo que ya fijó colocarArco().
      .fromTo(
        arcoItems,
        { y: () => hero.offsetHeight + 60 },
        {
          // En desktop cada uno aterriza en su lugar del arco; en mobile, en
          // el que le toca en el carrusel con el primero en la cima. La `x` ya
          // la dejó puesta colocarArco() en los dos casos.
          y: (i: number) => (esMovil ? alturaCarrusel(i) : alturaArco(i)),
          duration: 0.4,
        },
        ENTRADA_ARCO
      )
      .to(arcoItems, { opacity: 1, duration: 0.4, ease: 'none' }, ENTRADA_ARCO);

    // ---- EL GIRO, PASO A PASO ------------------------------------------
    // Un tween por salto, separados por una pausa: así cada beneficio se
    // planta un rato en la cima antes de que el círculo siga girando, en vez
    // de desfilar de corrido. Arranca cuando terminan de entrar y con una
    // pausa previa, para que el primero se lea antes de moverse.
    //
    // El ease es GOLPE como todo el resto (lo hereda de la timeline): frena
    // seco en el centro, que es lo que hace que cada parada se sienta como una
    // parada y no como una desaceleración.
    if (esMovil) {
      const MOV = 0.15; // lo que dura un salto
      const PAUSA = 0.1; // lo que se queda quieto en la cima

      // 0.4 es lo que dura la entrada: el giro empieza cuando esa cierra, más
      // una pausa para que el primero se lea antes de moverse.
      const ARRANQUE = ENTRADA_ARCO + 0.4 + PAUSA;

      for (let n = 1; n < arcoItems.length; n++) {
        lineaHero.to(
          giro,
          { i: n, duration: MOV, onUpdate: colocarArco },
          ARRANQUE + (n - 1) * (MOV + PAUSA)
        );
      }

      // Pausa final: sin esto el último salto termina justo en el borde de la
      // timeline, o sea que el quinto beneficio llega al centro en el mismo
      // instante en que se suelta el pin y no se llega a ver quieto. Es un
      // tween que no mueve nada (ya está en 4), solo alarga la timeline lo que
      // dura una pausa.
      lineaHero.to(
        giro,
        { i: arcoItems.length - 1, duration: PAUSA },
        ARRANQUE + (arcoItems.length - 1) * (MOV + PAUSA)
      );
    }

    // ---- ENTRADA DE LAS TARJETAS ---------------------------------------
    // Va fuera de la cadena porque es lo único que cambia de forma entre
    // desktop y mobile: no alcanza con valores distintos, en mobile se animan
    // propiedades que en desktop ni se tocan. El orden en que se agregan los
    // tweens no importa — con scrub lo único que cuenta es la posición en la
    // timeline, que en los dos casos es la misma.
    if (esMovil) {
      lineaHero
        // Etapa 1: las cuatro suben juntas desde abajo del corte hasta la fila
        // de espera, sin stagger y sin tocar la opacidad. Así "aparecen desde
        // abajo" de verdad, en vez de encenderse en el lugar.
        //
        // Ninguna de las dos etapas declara `ease`: heredan GOLPE del
        // `defaults` de la timeline, igual que todo lo demás del hero.
        //
        // Arranca en 0.15 y no en 0: el primer tramo del recorrido queda para
        // la transición del hero y las tarjetas entran después. La etapa 2
        // cierra en 1.04, apenas antes de que empiece la etapa 3 (1.05).
        .fromTo(
          tarjetas,
          { y: () => (hero ? hero.offsetHeight * FUERA_ABAJO : 0) },
          { y: (i: number) => filaY(i), duration: 0.28 },
          0.15
        )
        // Etapa 2: de a una salen de la fila y se acomodan en su escalón de la
        // pila. Arranca después de que cierra la etapa 1 (0.15 + 0.28 = 0.43):
        // si se solaparan, los dos tweens estarían escribiendo la misma `y` y
        // GSAP mataría uno por overwrite.
        //
        // El stagger es por índice y no `amount`: así el desfasaje entre una y
        // la siguiente es fijo (se ve entrar de a una en el orden del array)
        // en vez de repartirse entre las cuatro.
        .fromTo(
          tarjetas,
          { y: (i: number) => filaY(i) },
          {
            y: (i: number) => pila()[i],
            duration: 0.28,
            stagger: (i: number) => i * 0.1,
          },
          0.46
        );
    } else {
      lineaHero
        // Suben durante TODO el recorrido, sin tocar la opacidad: están
        // siempre presentes y llegan a su lugar junto con el resto.
        //
        // fromTo y no to: con `invalidateOnRefresh` el tween vuelve a leer su
        // valor de partida del estado actual, y si ya llegó a y:0 el arranque
        // queda en 0 y la tarjeta deja de moverse. Con el origen declarado
        // (y como función, para que se recalcule al redimensionar) el
        // recorrido sobrevive a cualquier refresh.
        .fromTo(
          tarjetas,
          {
            // Offset calculado por tarjeta: cada una arranca justo debajo del
            // borde inferior del hero. Un valor único no sirve porque las
            // cuatro tienen distinto `top` y las de arriba quedarían asomando
            // en la primera sección. offsetTop es la posición sin transformar,
            // así que no se contamina con lo que el propio tween ya escribió.
            y: (_i: number, objetivo: HTMLElement) =>
              hero.offsetHeight - objetivo.offsetTop + 40,
          },
          { y: 0, duration: 0.62, stagger: { amount: 0.08 } },
          // Arrancan al 30% en vez de al 50%. Con la curva GOLPE el avance es
          // casi nulo al principio, así que empezando en 0.5 recién se las
          // veía pasado el 75% del recorrido. La duración se estira en la
          // misma medida (0.62 + 0.08 de stagger) para que igual cierren en 1.
          0.3
        )
        // La opacidad se enciende junto con el movimiento, con ease lineal y
        // duración corta. Sin esto quedan invisibles: el gsap.set de más
        // arriba las apaga para que no se vean durante la entrada. No comparte
        // la curva GOLPE porque esa avanza muy poco al principio y las dejaría
        // semitransparentes casi todo el recorrido.
        .fromTo(tarjetas, { opacity: 0 }, { opacity: 1, duration: 0.06, ease: 'none' }, 0.3);
    }

    disparadorHero = lineaHero.scrollTrigger;

    // El destino del enlace "Beneficios" del nav. Se apunta un poco después de
    // que cierra la entrada del arco (ENTRADA_ARCO + 0.4), para que al llegar
    // ya estén los cinco en su lugar y no a mitad de camino.
    const marcarBeneficios = () => {
      const st = lineaHero.scrollTrigger;
      const total = lineaHero.duration();
      if (!st || !total) return;
      scrollBeneficios = st.start + ((ENTRADA_ARCO + 0.35) / total) * (st.end - st.start);
    };
    marcarBeneficios();
    ScrollTrigger.addEventListener('refresh', marcarBeneficios);
  }

  // Sin animación de entrada no hay onComplete que dispare el montaje.
  if (sinMovimiento) montarScroll();

  // ---------------------------------------------------------------------
  // A qué scroll corresponde el momento en que los beneficios del arco ya
  // están puestos. Lo calcula montarScroll() y lo recalcula en cada refresh:
  // depende del largo del pin y de la duración de la timeline, y esa duración
  // no es la misma en mobile (donde el carrusel agrega etapas) que en desktop.
  // Queda en null hasta que el scroll se monta, o sea durante la entrada, que
  // es justo cuando el scroll está bloqueado igual.
  let scrollBeneficios: number | null = null;

  // Saltos internos (nav y CTA). Duración fija en vez del smooth nativo: el
  // hero pineado agrega 3168px de recorrido que la vista no recorre, y a
  // velocidad constante ese tramo se sentía como una pausa. Con una duración
  // fija la distancia deja de importar y el salto dura siempre lo mismo.
  // Delegado en el document para que valga también para lo que se agregue después.
  // ---------------------------------------------------------------------
  document.addEventListener('click', (evento) => {
    const objetivo = evento.target as HTMLElement | null;
    const enlace = objetivo?.closest?.('a[href^="#"]') as HTMLAnchorElement | null;
    if (!enlace) return;

    const ancla = enlace.getAttribute('href');
    if (!ancla || ancla === '#') return;

    // "Beneficios" es la tercera etapa del hero, que no es una sección aparte
    // sino un momento de su timeline: pasa entera dentro del pin, así que no
    // hay ningún elemento del DOM a esa altura al que saltar. El destino se
    // calcula sobre el recorrido del pin — la posición 1.9 de la timeline, que
    // es cuando los beneficios ya terminaron de entrar.
    const destino =
      ancla === '#beneficios' ? scrollBeneficios : document.querySelector<HTMLElement>(ancla);
    if (!destino) return;

    evento.preventDefault();

    // El hero pineado se come el 81% del recorrido, y en ese tramo la pantalla
    // no se desplaza: solo avanza la animación. Con scrub 1.4 esa animación va
    // 1.4s atrás del scroll, así que en un salto rápido queda colgada en la
    // segunda sección mientras el scroll ya pasó de largo, y se lee como una
    // pausa. Durante el salto el scrub baja a casi cero para que la animación
    // vaya pegada al scroll, y se restaura al terminar.
    const scrub = disparadorHero?.getTween();
    const scrubOriginal = scrub?.duration();
    if (scrub) scrub.duration(0.1);
    const restaurarScrub = () => {
      if (scrub && scrubOriginal) scrub.duration(scrubOriginal);
    };

    gsap.to(window, {
      duration: 1.1,
      ease: 'power2.inOut',
      // autoKill: si el usuario mueve la rueda, el tween se corta y le
      // devuelve el control en vez de pelearle el scroll.
      scrollTo: { y: destino, autoKill: true, onAutoKill: restaurarScrub },
      onComplete: restaurarScrub,
    });
  });

  // Recién acá se destapa el hero: a esta altura ya corrieron todos los
  // gsap.set() sincrónicos, así que el primer frame visible muestra los
  // elementos en su posición de arranque y no apilados en la final.
  document.documentElement.setAttribute('data-listo', '');
</script>
