---
const moodItems = [
  {
    title: "Energy Mood",
    image: "/images/mano-naranja-trim.webp",
    // Cuánto está corrida la botella respecto del centro de la imagen, en % del
    // ancho: medido sobre el alfa del tercio superior de cada archivo. Se usa
    // para centrar la BOTELLA en la tarjeta, no la foto entera.
    desvio: 13.2,
    fondo: "/icons/fondo1.svg",
  },
  {
    title: "Fresh Mood",
    image: "/images/mano-amarillo-trim.webp",
    desvio: 17.2,
    fondo: "/icons/fondo2.svg",
  },
  {
    title: "Good Mood",
    image: "/images/mano-rojo-trim.webp",
    desvio: -13.1,
    fondo: "/icons/fondo3.svg",
  },
];
---

<section id="mood" class="bg-[#66AAD4] py-16 min-h-[80vh]">
  <div class="container mx-auto px-4 flex flex-col items-center text-center">

    <h2
      data-mood-titulo
      class="text-6xl font-bold text-[#850E10] mb-8 font-duper max-w-[500px]"
    >
      Elegí cómo querés sentirte hoy
    </h2>
    
    {/* Las tres en una sola fila desde md. Lo que hacía falta para que eso no
        se saliera de la pantalla era sacarles el `min-w-[400px]` a las
        tarjetas (ver abajo): sin ancho mínimo se reparten el lugar que haya y
        el `max-w` las topa cuando sobra. El gap también achica en medianas,
        que es donde cada px de ancho cuenta.

        `w-full` en la grilla: el contenedor de arriba es un flex con
        `items-center`, y eso encoge a los hijos a su contenido — sin ancho
        propio, las columnas salían de 198px en vez de repartirse el lugar
        disponible. */}
      <div class="grid w-full grid-cols-1 justify-items-center gap-4 md:grid-cols-3 md:gap-6 xl:gap-8">
      {/* Sin ancho mínimo: con `min-w-[400px]` tres columnas pedían 1264px, así
          que desde los 768 en que arranca el grid de tres y hasta ahí se salían
          de la pantalla — y en mobile una sola ya no entraba en 390. El `max-w`
          las sigue topando cuando sobra lugar. */}
      {moodItems.map((mood) => (
        <div
          data-mood-tarjeta
          class="relative flex w-full max-w-[380px] min-h-[620px] flex-col items-center overflow-hidden rounded-[31px] bg-cover bg-center bg-no-repeat p-6"
          style={`background-image: url('${mood.fondo}');`}
        >
          {/* La mano ya no viene pegada al fondo: el fondo es el SVG de la
              tarjeta (rayas y color) y esto es una capa aparte encima.

              Se centra la BOTELLA, no la foto: la mano entra en diagonal, así
              que el centro de la imagen no coincide con el del envase. Cada
              archivo trae medido cuánto está corrida (`desvio`) y el translate
              le suma esa corrección al -50% de siempre. El brazo, en
              consecuencia, sale cortado por el borde de la tarjeta.

              El ancho manda y el alto es automático: con `object-contain` en
              una caja de proporción distinta, la foto se centraría adentro de
              esa caja y la corrección en % dejaría de coincidir.

              Ese ancho (82%) no es estético sino geométrico: con la botella
              centrada, el borde de la foto del lado del brazo queda a
              (0.5 + desvio) veces su ancho del centro de la tarjeta, así que
              para que el brazo llegue al borde y se corte ahí —en vez de
              terminar en el aire— la foto tiene que medir al menos el ancho
              de la tarjeta dividido 1.3. */}
          {/* Envoltorio del tamaño exacto de la tarjeta (inset-0), y por eso la
              posición de la foto adentro no cambia en nada. Existe solo para
              que la entrada tenga dónde agarrarse: la <img> ya tiene ocupadas
              sus dos propiedades de movimiento —`translate` con la corrección
              que centra la botella, `transform` con el vaivén en loop del
              <style> de abajo— y GSAP escribe `transform`, así que animarla
              directamente le pisaría la flotación.

              Al ser del tamaño de la tarjeta, un xPercent de 100 la deja justo
              afuera por la derecha y el overflow-hidden de la tarjeta la
              recorta: de ahí sale el "entra desde la derecha". */}
          <div data-mood-botella class="pointer-events-none absolute inset-0">
            <img
              src={mood.image}
              alt=""
              aria-hidden="true"
              data-mood-flota
              class="pointer-events-none absolute bottom-0 left-1/2 h-auto w-[82%] object-contain"
              style={`translate: ${-50 - mood.desvio}% 0;`}
            />
          </div>

          <h3 class="relative z-10 mt-8 font-duper text-3xl font-bold text-crema">{mood.title}</h3>
        </div>
      ))}
    </div>
  </div>


</section>

<style>
  /* Flotación en loop. Va en `transform` y no en `translate` a propósito: el
     `translate` de cada imagen ya está ocupado por la corrección que centra la
     botella, y son dos propiedades distintas que el navegador compone una
     después de la otra — así el vaivén se suma sin pisar ese ajuste.

     2.2s por ciclo completo y `ease-in-out`, que sube y baja frenando en los
     extremos; con `linear` el rebote se siente mecánico. Las tres arrancan
     juntas porque comparten la misma animación y el mismo momento de inicio. */
  @keyframes flotar-mood {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-14px);
    }
  }

  [data-mood-flota] {
    animation: flotar-mood 2.2s ease-in-out infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-mood-flota] {
      animation: none;
    }
  }
</style>

<script>
  import { gsap, GOLPE, esperarHero } from '../../scripts/entrada';

  const sinMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  // Solo desde md. En mobile las tres tarjetas van apiladas en una columna de
  // ~1900px, así que un único rango de scroll para la sección entera
  // resolvería la animación con la segunda y la tercera todavía fuera de
  // pantalla: cuando el visitante llega a ellas ya están puestas y no se ve
  // nada. Sin animación, la sección queda tal como estaba.
  //
  // Se consulta acá y no con gsap.matchMedia(): ese abre un contexto que se
  // cierra en cuanto termina su callback, y la timeline de abajo se crea
  // bastante después (esperarHero es asíncrono). El ScrollTrigger nacía
  // huérfano, sin refrescar nunca — start en 0 y end en null, o sea que no
  // avanzaba con el scroll. Mismo chequeo directo que usan Home y Momento.
  const esEscritorio = window.matchMedia('(min-width: 768px)').matches;

  const seccion = document.querySelector<HTMLElement>('#mood');
  const titulo = document.querySelector<HTMLElement>('[data-mood-titulo]');
  // DOM order == orden visual izquierda a derecha, igual que en Momento: el
  // stagger sale del propio array, sin reordenar nada.
  const tarjetas = gsap.utils.toArray<HTMLElement>('[data-mood-tarjeta]');
  const botellas = gsap.utils.toArray<HTMLElement>('[data-mood-botella]');

  if (seccion && titulo && tarjetas.length && esEscritorio && !sinMovimiento) {
    const DUR = 1;

    // Bastante más que el alto de la tarjeta: así arrancan desde fuera de la
    // sección y no "apareciendo" a media altura (mismo criterio que Momento).
    const SUBIDA = () => Math.round(window.innerHeight * 0.35);

    gsap.set(titulo, { y: 120, opacity: 0 });
    gsap.set(tarjetas, { y: SUBIDA, opacity: 0 });
    // xPercent y no x: el envoltorio mide lo mismo que la tarjeta, así que 100
    // lo deja justo afuera por la derecha sea cual sea el ancho de columna.
    gsap.set(botellas, { xPercent: 100 });

    esperarHero(() => {
      // Se repite el estado oculto: el `set` de arriba corre apenas carga el
      // módulo, y en ese instante innerHeight puede no estar listo todavía (da
      // 0, y SUBIDA con él). No se ve ningún salto porque el opacity: 0 ya lo
      // venía tapando.
      gsap.set(titulo, { y: 120, opacity: 0 });
      gsap.set(tarjetas, { y: SUBIDA, opacity: 0 });

      gsap
        .timeline({
          defaults: { ease: GOLPE, duration: DUR },
          scrollTrigger: {
            trigger: seccion,
            start: 'top 85%',
            end: 'top 15%',
            scrub: 0.6,
            invalidateOnRefresh: true,
          },
        })
        .to(titulo, { y: 0, opacity: 1 }, 0)
        .to(tarjetas, { y: 0, opacity: 1, stagger: { amount: 0.5 } }, 0.15)
        // Las tres juntas y recién cuando la última tarjeta terminó de entrar
        // (0.15 de arranque + 0.5 de stagger + 1 de duración = 1.65). Sin
        // stagger acá a propósito: son dos tiempos distintos, primero se arman
        // las tarjetas una por una y después entran las botellas de una.
        //
        // El GOLPE de los defaults es el que da el efecto: casi quietas al
        // principio y entrando de un saque sobre el final.
        .to(botellas, { xPercent: 0 }, 1.65);
    });
  }
</script>
