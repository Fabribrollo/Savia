---
import Aura from '../Aura.astro';

// Las tres botellas están recortadas al envase, sin bordes, y con la misma
// proporción (0.367-0.369 de ancho sobre alto), así que a igual alto quedan a
// la misma escala y alineadas sin compensar nada. El width/height de abajo es
// solo la proporción para reservar el lugar antes de que carguen.
//
// En mobile el tamaño se fija por ANCHO y no por alto, al revés que en
// desktop. Es la única forma de garantizar que la fila entre siempre: con
// `h-[41vh]` el ancho sale del alto de la ventana (0.368 veces), así que en
// una pantalla achatada —o en horizontal— la fila se pasaba del ancho igual.
// Con 31vw + 34vw + 31vw y los dos solapes de 24px, la fila mide 96vw − 48px
// pase lo que pase; y `w-auto` no hace falta declararlo en mobile porque el
// alto lo resuelve el `h-auto`. En md vuelve a mandar el alto.
//
// Van en el flujo, sin `absolute`: el solape lo hacen los márgenes negativos y
// el orden de apilado lo decide el z-index, que en un contenedor flex vale
// aunque los items sean `position: static`. El tamaño se fija por alto y el
// ancho sale solo; con `max-h` las tres quedarían topadas a la misma altura y
// la del centro terminaría siendo la más chica.
const botellas = [
  {
    nombre: 'Naranja & Jengibre',
    imagen: '/images/naranja-trim.webp',
    // Las laterales van apenas más bajas y corridas: eso alcanza para mandarlas
    // hacia atrás. Sin desplazamiento vertical, así las tres bases coinciden
    // (de eso se encarga el `items-end` del contenedor).
    clase: 'z-10 h-auto w-[31vw] -mr-6 md:h-[64vh] md:w-auto md:-mr-11',
    // Orden de entrada al hacer scroll (no el visual, que es naranja-roja-
    // amarilla de izquierda a derecha): naranja, amarilla, roja.
    orden: 1,
  },
  {
    nombre: 'Frutos Rojos',
    imagen: '/images/rojo-trim.webp',
    clase: 'z-20 h-auto w-[34vw] md:h-[70vh] md:w-auto',
    orden: 3,
  },
  {
    nombre: 'Lima & Menta',
    imagen: '/images/amarillo-trim.webp',
    clase: 'z-10 h-auto w-[31vw] -ml-6 md:h-[64vh] md:w-auto md:-ml-11',
    orden: 2,
  },
];

// Etiquetas de cada sabor, posicionadas contra la sección en los dos tamaños.
// En desktop hay lugar a los costados de las botellas; en mobile no, así que
// las dos de arriba van en fila sobre ellas y la del centro abajo.
//
// El z-30 va en cada bloque: las botellas son z-10/z-20 y si no, le pasarían
// por encima al texto de abajo.
//
// En mobile las dos de arriba NO van absolutas: entre el título y las botellas
// quedan apenas 40px y se encimaban con los dos. Puestas en el flujo, como una
// fila, el propio flex de la sección les hace lugar.
// Los saltos de línea de mobile van escritos en el dato, con un <br> que se
// apaga en md. No es tan lindo como dejar que el texto envuelva solo, pero
// envolver solo obliga a ponerle un ancho máximo a la caja, y ese ancho es un
// único número que tiene que servir para tres textos de largos distintos: el
// que corta bien a "Naranja & Jengibre" deja a "Frutos Rojos" de una línea, y
// el que corta a los tres deja el bloque angosto. Con el corte explícito cada
// etiqueta queda como corresponde y no hace falta ningún tope de ancho.
//
// Por eso los <br> llevan `md:hidden`: en desktop el texto vuelve a fluir
// dentro de sus `md:w-[24%]` / `md:w-[36%]` como venía haciéndolo. El espacio
// después del <br> es el que separa las dos palabras cuando el salto no está.
//
// Ojo al editar: se renderizan con `set:html`, así que "&" va como `&amp;`.
const etiquetas = [
  {
    titulo: 'Naranja &amp;<br class="md:hidden" /> Jengibre',
    bajada: 'Un impulso natural<br class="md:hidden" /> para seguir',
    zona: 'arriba',
    // 8% y no 4%: el texto va centrado en una caja de 24% de ancho, así que lo
    // que se ve terminaba a 84px de las botellas aunque la caja quedara a 28.
    pos: 'md:absolute md:left-[8%] md:top-[33%] md:w-[24%]',
  },
  {
    titulo: 'Lima &amp;<br class="md:hidden" /> Menta',
    bajada: 'Frescura que<br class="md:hidden" /> revitaliza',
    zona: 'arriba',
    // 9% de este lado y no 8%: "Lima & Menta" es más corto que "Naranja &
    // Jengibre", así que centrado en la misma caja su texto arranca más
    // adentro y quedaba 24px más lejos de la botella que el otro.
    pos: 'md:absolute md:right-[9%] md:top-[30%] md:w-[24%]',
  },
  {
    titulo: 'Frutos Rojos',
    bajada: 'Un equilibrio entre<br class="md:hidden" /> dulzura y frescura',
    zona: 'abajo',
    // Sube de 3% a 9% SOLO en mobile: pegada al pie no tenía aire ni con la
    // botella de arriba ni con la sección siguiente. En desktop se queda en el
    // 1.5% original — ahí abajo hay lugar de sobra y subirla la metía encima
    // de la botella.
    pos: 'absolute bottom-[9%] left-1/2 w-[80%] -translate-x-1/2 md:bottom-[1.5%] md:w-[36%]',
  },
];

// Las botellas ocupan de ~30% a ~70% de ancho: el grupo "pegado" usa esos
// bordes como referencia para quedar rozándolas. `tam` va en vw sin unidad
// (ver .fruta: lleva un piso en px para que en mobile no queden diminutas).
const frutas = [
  { tipo: 'sandia', pos: 'left-[4%] top-[44%]', tam: 9, giro: -18 }, // sandía izquierda medio, mediano
  { tipo: 'frutilla', pos: 'left-[8%] top-[9%]', tam: 8, giro: 14 }, // frutilla arriba izquierda, mediano
  // --- rodean la botella, sin tocarla ---
  { tipo: 'jengibre', pos: 'left-[30%] top-[50%]', tam: 7, giro: -10 }, // jengibre izquierda medio, al lado de las botellas
  { tipo: 'sandia', pos: 'left-[30%] top-[70%]', tam: 8, giro: 22 }, // sandía extremo bajo izquierdo
  { tipo: 'sandia', pos: 'right-[30%] top-[70%]', tam: 8, giro: -16 }, // sandía extremo bajo derecho
  { tipo: 'hojaMenta', pos: 'right-[30%] top-[50%]', tam: 7, giro: 12 }, // hoja de menta derecha medio, al lado de las botellas
  // Arriba de la tapa (top-[21%] es donde empieza la botella más alta), no
  // encima de ella.
  { tipo: 'frutilla', pos: 'left-[40%] top-[11%]', tam: 6, giro: -9 }, // frutilla entre las botellas y el título
  { tipo: 'arandano', pos: 'right-[40%] top-[13%]', tam: 4.5, giro: 16 }, // arándano entre las botellas y el título
  // --- fin del grupo pegado ---
  { tipo: 'arandano', pos: 'right-[6%] top-[8%]', tam: 5, giro: -12 }, // arándano arriba derecha
  { tipo: 'hojaMenta', pos: 'right-[6%] top-[68%]', tam: 7, giro: 19 }, // hoja de menta derecha medio (segunda)
  { tipo: 'jengibre', pos: 'right-[10%] top-[30%]', tam: 7, giro: -14 }, // jengibre abajo derecha
];
---

{/* Envoltorio del "agua". La sección no se anima ni se mueve por su cuenta:
    lo que la hace subir es el pin del banner (ver Banner.astro), que deja esa
    sección fija mientras esta sigue el scroll normal y le pasa por encima.
    El z-20 es lo que decide ese "por encima": el banner pineado queda en
    position:fixed y sin esto se pintaría delante.

    El envoltorio existe para poder colgar la ola FUERA de la sección: la
    sección lleva overflow-hidden (recorta las frutas) y ahí adentro la ola
    quedaría cortada. */}
<div class="relative z-20">

  {/* La línea de agua. El contenedor recorta a lo ancho para que la ola pueda
      ser más ancha que la pantalla y derivar en horizontal sin descubrir los
      bordes (ver el vaivén en el script). Su alto sale del aspect-ratio del
      SVG y el bottom lo apoya justo arriba del azul; el -1px es para que no
      quede una hendija entre la ola y el bloque de agua por redondeo. */}
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 bottom-[calc(100%-1px)] z-10 aspect-[1440/279] overflow-hidden"
  >
    <img
      data-ola-favorita
      src="/icons/separador.svg"
      alt=""
      class="absolute bottom-0 left-[-5%] w-[110%] max-w-none"
    />
  </div>

{/* El pb corre hacia arriba el contenido en flujo (título y botellas), que es
    lo que abre el aire entre la base de las botellas y la etiqueta de "Frutos
    Rojos" — esa etiqueta es `absolute bottom-[%]`, así que no se mueve con el
    padding y el hueco crece.
    En desktop hace falta por una cuenta concreta: las botellas terminaban en
    754 de una sección de 800, y la etiqueta mide 56px, o sea que no entraba
    debajo y se le montaba encima. Los 64px de pb suben la base lo suficiente. */}
<section
  id="favorita"
  class="relative isolate flex min-h-dvh flex-col items-center justify-center gap-10 overflow-hidden bg-[#66AAD4] pb-44 md:pb-16"
>
  {/* Frutas del fondo, mismo tratamiento que Home.astro: z-0 y primeras en
      el DOM, quedan detrás del título y de las botellas. */}
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 z-10">
    {
      frutas.map(({ tipo, pos, tam, giro }) => (
        <img
          data-fruta-favorita
          data-giro={giro}
          src={`/icons/fondo/${tipo}-celeste.svg`}
          alt=""
          aria-hidden="true"
          class:list={['fruta absolute block', pos]}
          style={`--tam:${tam};aspect-ratio:1;`}
        />
      ))
    }
  </div>

  {/* clamp en vez de text-7xl: eran 72px fijos en cualquier pantalla, así que
      en un teléfono el título ocupaba el ancho completo y empujaba todo lo de
      abajo. El tope (4.5rem) es el mismo text-7xl de antes, o sea que en
      desktop no cambia. */}
  <h2
    class="relative z-10 text-center font-duper font-bold text-[#850E10]"
    style="font-size: clamp(2.35rem, 10.2vw, 4.5rem);"
  >
    {/* Mismo mecanismo que el titular del hero: la línea recortada por su
        propia máscara, el texto entra letra por letra (ver el script). */}
    <span class="block overflow-hidden py-[0.06em] -my-[0.06em]">
      <span class="block" data-linea-favorita>Encontrá tu favorita</span>
    </span>
  </h2>

  {/* Las dos de arriba. `md:contents` saca este envoltorio del layout a partir
      de md, y ahí cada una se acomoda sola con su `md:absolute`. */}
  <div class="z-30 flex w-full items-start justify-between gap-3 px-3 text-center text-[#FFEDC2] md:contents">
    {
      etiquetas
        .filter(({ zona }) => zona === 'arriba')
        .map(({ titulo, bajada, pos }) => (
          <div data-etiqueta-favorita class:list={['w-[46%] text-center', pos]}>
            <h3
              class="font-duper text-[clamp(1.4rem,7.4vw,1.8rem)] font-bold leading-tight md:text-[2.1vw]"
              set:html={titulo}
            />
            <p
              class="font-futura text-[clamp(0.95rem,4.9vw,1.2rem)] font-medium leading-snug md:mt-1 md:text-[1.05vw]"
              set:html={bajada}
            />
          </div>
        ))
    }
  </div>

  {/* La sombra de las botellas va en vh y no en px, y más corta que antes.
      Con los 30px de offset y 50px de blur que tenía necesitaba 80px por
      debajo de la base, y ahí abajo no siempre hay tanto: 72px en un portátil
      de 810 y apenas 47px en un teléfono de 844 (el título ocupa más líneas y
      empuja todo). O sea que el overflow-hidden le cortaba la cola en una
      línea horizontal justo contra Momento — eso era la "sombra cortada".
      1.8vh + 3vh piden 4.8% del alto, que entra en las dos.

      Lo único que no cubre es una ventana muy achatada (tipo 430px de alto),
      donde abajo de la base quedan 15px y no entra ninguna sombra. */}
  <div class="relative flex items-end justify-center">

    {/* Aura detrás de la botella central. z-[5]: por encima de las frutas,
        debajo de las botellas (z-10/z-20).

        Su punto más bajo es la base de las botellas, y no se calcula: el
        bloque va adentro del contenedor de las botellas, anclado a su
        `bottom`. Como ese contenedor es `items-end`, su borde de abajo ES la
        línea donde apoyan las tres, así que el círculo termina ahí solo — y
        sigue haciéndolo si cambian de alto.

        El corrimiento hace que asome apenas por debajo de esa base: el
        degradado se apaga en el 92% del radio (--aura-fin), o sea que lo que
        se ve termina un 4% del alto antes que la caja.

        shrink-0 porque es item de un flex: sin eso el navegador lo achica
        hasta el ancho de la fila de botellas y el max-w queda de adorno.

        En mobile el ancho va en 135vw y no en 100vw: con 100vw el círculo
        medía casi lo mismo que la fila de botellas (390 contra 352), así que
        quedaba enteramente tapado por ellas y no se veía nada. Con 135vw
        asoma por arriba y por los costados; lo que se pasa del ancho de la
        pantalla lo recorta el overflow de la sección. */}
    <div class="pointer-events-none absolute inset-x-0 bottom-0 z-[5] flex justify-center">
      <div class="relative aspect-square w-[135vw] max-w-[760px] shrink-0 translate-y-[10%] md:w-[100vw]">
        <Aura marca="favorita" size="100%" color="#0071B8" nucleo="58%" fin="92%" intensidad={1} />
      </div>
    </div>

    {
      botellas.map(({ nombre, imagen, clase, orden }) => (
        <img
          src={imagen}
          alt={`Botella de jugo Savia sabor ${nombre}`}
          width="318"
          height="863"
          data-botella-favorita
          data-orden={orden}
          class:list={[
            // Sin `w-auto` acá: el ancho lo decide `clase`, que en mobile lo
            // fija en vw. Con las dos utilidades de `width` presentes gana la
            // que la hoja de Tailwind ponga última, y ganaba `w-auto`.
            'object-contain drop-shadow-[0_1.8vh_3vh_rgba(90,100,20,0.28)]',
            clase,
          ]}
        />
      ))
    }
  </div>

  {
    etiquetas
      .filter(({ zona }) => zona === 'abajo')
      .map(({ titulo, bajada, pos }) => (
        <div data-etiqueta-favorita class:list={['z-30 mx-auto text-center text-[#FFEDC2]', pos]}>
          <h3
            class="font-duper text-[clamp(1.4rem,7.4vw,1.8rem)] font-bold leading-tight md:text-[2.1vw]"
            set:html={titulo}
          />
          <p
            class="font-futura text-[clamp(0.95rem,4.9vw,1.2rem)] font-medium leading-snug md:mt-1 md:text-[1.05vw]"
            set:html={bajada}
          />
        </div>
      ))
  }
</section>
</div>

<style>
  /* Mismo mecanismo que .fruta en Home.astro: el SVG de máscara aporta la
     silueta, el color sale del background-color (no del archivo). */
  /* Antes era un <span> pintado con `background-color` y recortado por
     `mask-image`; ahora es un <img> con el color ya adentro del archivo (ver
     /icons/fondo). Las máscaras son de lo más caro de rasterizar y una imagen
     se decodifica una sola vez — el cambio salió de un parpadeo en el hero,
     donde se redibujaban todas juntas. El color y el opacity de marca de agua
     ahora viven en el SVG. */
  .fruta {
    /* El tamaño sale de un número suelto (`--tam`, en vw) y no de un `width`
       inline, para poder ponerle un piso: en mobile 1vw es tan poco que las
       frutas quedaban como manchitas. Con max() manda el vw mientras la
       pantalla sea ancha y, por debajo de ~1000px, pasa a mandar el px — que
       es el mismo número multiplicado, así que la jerarquía de tamaños entre
       frutas se mantiene igual. Sin breakpoint: el cambio de una fórmula a la
       otra ocurre justo donde se cruzan, sin salto. */
    width: max(calc(var(--tam) * 1vw), calc(var(--tam) * 10px));

  }
</style>

<script>
  import { gsap, GOLPE, esperarHero, letrasDiagonal } from '../../scripts/entrada';

  const sinMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const seccion = document.querySelector<HTMLElement>('#favorita');

  // Orden de ENTRADA (naranja, amarilla, roja), no el orden del DOM (que es
  // el orden visual naranja-roja-amarilla). data-orden lo puso el frontmatter;
  // acá solo se ordena el array de targets antes de pasárselo al stagger, así
  // GSAP los anima en la secuencia pedida sin tocar el layout.
  const botellas = gsap.utils
    .toArray<HTMLElement>('[data-botella-favorita]')
    .sort((a, b) => Number(a.dataset.orden) - Number(b.dataset.orden));

  const frutas = gsap.utils.toArray<HTMLElement>('[data-fruta-favorita]');

  // El giro lo escribe GSAP y no el CSS. En el marcado iba como propiedad
  // `rotate`, que es independiente de `transform`: al animarles la `y`, GSAP
  // toma el control de las tres (translate/rotate/scale) y el valor del CSS
  // deja de ser confiable. Como `gsap.set` acá es estático (no una animación),
  // va afuera del guard de prefers-reduced-motion: sin movimiento las frutas
  // igual tienen que quedar giradas.
  gsap.set(frutas, { rotation: (_i, el: HTMLElement) => Number(el.dataset.giro) });

  if (seccion && !sinMovimiento) {
    const DUR = 1;
    const REPARTO = 0.2;

    // Cuánto bajar un elemento para dejarlo justo debajo del borde inferior de
    // la sección. Se mide contra su propio `offsetTop` (que ya es relativo a
    // la sección) en vez de usar un vh fijo: las frutas están repartidas por
    // toda la altura, así que un mismo número las dejaría a unas fuera y a
    // otras a mitad de camino. Con esto todas arrancan igual de tapadas por el
    // overflow-hidden — que es lo que reemplaza al fade: no hace falta
    // desvanecer nada si el elemento entra desde afuera del recorte.
    const desdeAbajo = (_i: number, el: HTMLElement) => seccion.offsetHeight - el.offsetTop;

    gsap.set('[data-linea-favorita]', { yPercent: 115 });
    gsap.set('[data-aura="favorita"]', { scale: 0.15 });
    gsap.set('[data-etiqueta-favorita]', { opacity: 0, y: 24 });
    gsap.set(botellas, { y: desdeAbajo });
    gsap.set(frutas, { y: desdeAbajo });

    esperarHero(() => {
      document.fonts.ready.then(() => {
        const letras = letrasDiagonal('[data-linea-favorita]');

        // Momento en que entran botellas y texto. Las frutas del fondo
        // arrancan solas antes (en 0) y el resto cae junto acá: el texto ya no
        // se adelanta a las botellas, entran a la par.
        const JUNTOS = 0.3;

        gsap
          .timeline({
            defaults: { ease: GOLPE, duration: DUR },
            scrollTrigger: {
              trigger: seccion,
              // Más tarde que antes ('top 90%' → 'top 20%'): la sección sube
              // como agua sobre el banner, y con el rango viejo lo de adentro
              // ya estaba armado cuando todavía se veía apenas una franja.
              // Ahora el primer tercio de esa subida es solo agua.
              start: 'top 70%',
              end: 'top 5%',
              scrub: 0.6,
              // Los `desdeAbajo` son funciones: sin esto quedarían con la
              // medida del primer cálculo y al redimensionar las frutas
              // arrancarían de cualquier lado.
              invalidateOnRefresh: true,
            },
          })
          // fromTo y no to en TODO, no solo en lo que mide por función: con
          // invalidateOnRefresh, un `to` relee su origen del estado actual y
          // si el refresh cae con el tween resuelto se queda sin recorrido
          // (mismo problema que documenta Home.astro).
          //
          // 'random' y no el orden del array: son fondo, y un stagger parejo
          // de izquierda a derecha se lee como una fila ordenada en vez de
          // como algo que flota hacia arriba.
          .fromTo(
            frutas,
            { y: desdeAbajo },
            { y: 0, stagger: { amount: 0.5, from: 'random' } },
            0
          )
          .fromTo(
            letras,
            { yPercent: 115, x: -22 },
            { yPercent: 0, x: 0, duration: DUR - REPARTO, stagger: { amount: REPARTO } },
            JUNTOS
          )
          // Sin opacity: las botellas ya no aparecen de la nada, entran
          // enteras desde abajo del recorte de la sección.
          // "Debe verse fluido": stagger amplio (0.35 de los DUR=1 totales)
          // para que la segunda y la tercera arranquen bien solapadas con la
          // anterior en vez de esperar a que termine.
          .fromTo(
            botellas,
            { y: desdeAbajo },
            { y: 0, stagger: { amount: 0.35, ease: 'none' } },
            JUNTOS
          )
          // El aura entra detrás de las botellas, no con ellas: arranca un
          // cuarto de tiempo después de que ellas empiezan a subir y cierra en
          // el mismo instante que la última. Así el halo se abre sobre un
          // grupo que ya está armándose, en vez de crecer con la escena vacía.
          // Con GOLPE como todo el resto (hereda el default de la timeline).
          .fromTo(
            '[data-aura="favorita"]',
            { scale: 0.15 },
            { scale: 1, duration: DUR + 0.1 },
            JUNTOS + 0.25
          )
          // Las etiquetas entran últimas, cuando las botellas ya están casi en
          // su lugar: son el pie de foto de algo que primero tiene que estar.
          .fromTo(
            '[data-etiqueta-favorita]',
            { opacity: 0, y: 24 },
            { opacity: 1, y: 0, duration: DUR, stagger: { amount: 0.2 } },
            JUNTOS + 0.5
          );
      });
    });

    // ---- MAREA ---------------------------------------------------------
    // La ola nunca queda quieta: dos loops sueltos del scroll, que es lo que
    // hace que la línea de agua se lea como agua y no como un borde recortado
    // mientras sube.
    //
    // Son dos tweens y no uno con períodos distintos (5s y 3.2s) a propósito:
    // como no son múltiplos, la combinación tarda 16s en repetirse igual y
    // nunca se le ve el ciclo. Van en porcentaje y no en píxeles para que el
    // recorrido escale con el ancho de la pantalla.
    const ola = '[data-ola-favorita]';

    // Lateral: el movimiento principal. Simétrico (-2 a 2) y no de 0 hacia un
    // lado, así el agua hamaca en los dos sentidos en vez de irse siempre
    // para el mismo. El contenedor le da 5% de sobrante de cada lado, así que
    // con 2% nunca asoma el final de la imagen.
    gsap.fromTo(
      ola,
      { xPercent: -2 },
      { xPercent: 2, duration: 5, ease: 'sine.inOut', yoyo: true, repeat: -1 }
    );

    // Vertical: mucho más chico, solo para que la cresta respire. Siempre
    // hacia abajo (0 a 2) y nunca hacia arriba: la tinta del SVG llega justo
    // al borde de abajo de la imagen, así que subiéndola se abriría una
    // hendija entre la ola y el bloque de agua. Bajando, lo que se recorta
    // queda tapado por el agua misma y no se ve.
    gsap.fromTo(
      ola,
      { yPercent: 0 },
      { yPercent: 2, duration: 3.2, ease: 'sine.inOut', yoyo: true, repeat: -1 }
    );
  }
</script>
