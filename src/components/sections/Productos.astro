
---
const jugos = [
  {
      nombre: 'Naranja & Jengibre',
      color: '850E10',
      imagen: '/images/naranja-trim.webp',
      fondo: '/images/naranjafondo.webp',
    },
    {
      nombre: 'Frutos Rojos',
      color: '9BA200',
      imagen: '/images/rojo-trim.webp',
      fondo: '/images/rojofondo.webp',
    },
  {
    nombre: 'Lima & Menta',
    color: '0071B8',
    imagen: '/images/amarillo-trim.webp',
    fondo: '/images/amarillofondo.webp',
  },
];

---

{/* justify-start (no justify-center) y flex-1 (no h-full) en el div de
    adentro: centrado dejaba mucho margen arriba antes de que asome el
    título. Con justify-start el contenido arranca pegado al padding de
    arriba, así se ve antes al entrar en pantalla. flex-1 sigue haciendo
    falta para que el div ocupe el alto real de la sección: la sección
    define el suyo con min-height, y los porcentajes de height solo miden
    contra un height real del padre (mismo caso que Banner.astro). */}
<section
  id="productos"
  data-hero
  class="relative isolate flex min-h-dvh flex-col overflow-hidden bg-lima"
>
  {/* px-8 y no mx-8: combinado con w-full, el margen se SUMA al 100% del
      ancho del padre (100% + 64px) y la sección se desbordaba a lo ancho.
      Como padding, el espacio queda adentro de la caja. */}
  {/* pt grande en mobile: el hero termina con los beneficios apoyados sobre el
      arco, bien abajo en la pantalla, y el título de Productos arrancaba
      pegado justo debajo. El aire separa las dos secciones. En sm+ vuelve al
      pt-4 de siempre, donde el problema no se daba. */}
  <div class="flex flex-1 flex-col items-center justify-start w-full pt-24 px-3 sm:pt-4 sm:px-8 mb-8">
    {/* El tamaño está en el bloque de estilos del final del archivo y no acá,
        porque cambia de fórmula entre mobile y sm+ y un `style` inline no
        admite media query.

        En mobile el título va en DOS renglones (el <br> de abajo, que se
        apaga en sm+). No es un capricho: en un solo renglón el texto mide 8.5
        veces el tamaño de fuente, así que contra los (100vw - 24px) de ancho
        útil el techo eran 43px en un teléfono de 390. Partido, el renglón más
        largo ("Tu momento.") mide 5.1 veces, y eso deja llegar a 62px sin que
        se recorte. */}
    <h2
      class="titulo-prod w-full whitespace-nowrap text-center font-bold text-[#850E10] font-duper"
    >
      {/* Una sola línea (whitespace-nowrap: sin el salto que tenía "Tu
          momento." / "Tu sabor" antes). Mismo mecanismo que el titular del
          hero: la línea recortada por su máscara, así el texto entra
          deslizándose desde abajo. */}
      <span class="block overflow-hidden py-[0.06em] -my-[0.06em]">
        <span class="block" data-linea-prod>Tu momento.<br class="sm:hidden" /> Tu sabor</span>
      </span>
    </h2>
    {/* mt-8 acá arriba, igual al mt-8 que ya traía la fila de tarjetas ahí
        abajo: mismo espacio de los dos lados, así el subtítulo queda
        centrado en el hueco entre el título y las tarjetas. */}
    {/* my-6 (24px arriba y abajo) y la fila de tarjetas sin mt: entre el
        título y las tarjetas hay 76px y el subtítulo mide 28, así que 24 de
        cada lado lo dejan centrado exacto. La fila arranca en el mismo punto
        que antes (24 + 0 = los 16 + 32 que había), o sea que el layout no se
        corre. Ojo: el rect del subtítulo se ve 40px más abajo de lo que dice
        el layout, porque su estado inicial de GSAP es y:40. */}
    <h5 data-sub-prod class="my-6 text-center text-lg font-futura text-md text-[#520000] font-medium justify-center ">
      Tres sabores. Tres formas de disfrutar la frescura.
    </h5>

{/* Las tarjetas se adaptan al ancho disponible: `w-full` con tope de 500px y
    sin ancho mínimo. Antes tenían `md:min-w-[500px]`, con la idea de que en
    fila ya había lugar — pero tres de 500 con sus gaps piden 1564px, así que
    entre 768 y 1564 se salían de la pantalla y empujaban el ancho del
    documento. Sin mínimo, en fila se reparten lo que haya y recién a partir de
    ~1600 llegan a los 500 que las topan. */}
<div class="flex flex-col md:flex-row justify-center items-center gap-8 w-full mb-16">
  {jugos.map((jugo) => (
  <div
    data-tarjeta-prod
    class="group card-jugo relative flex w-full max-w-[500px] flex-col justify-center items-center gap-4 rounded-4xl p-4 overflow-hidden border border-white/35 bg-white/14 shadow-[inset_0_0_22px_rgba(0,0,0,0.13)] backdrop-blur-md backdrop-saturate-[1.2]"
    style={`color: #${jugo.color};`}
  >
    <h2 class="text-4xl font-bold text-center pt-10 pt-6 font-duper z-10">{jugo.nombre}</h2>
    <!-- Fondo que aparece en hover (y con `data-activa`, que es el hover de
         mentira que usa el toque en pantallas sin puntero — ver el script). -->
    <div
      class="absolute inset-0 bg-cover bg-center opacity-0 transition-opacity duration-300 group-hover:opacity-100 group-[[data-activa]]:opacity-100"
      style={`background-image: url(${jugo.fondo});`}
    ></div>

    <!-- Reflejo apenas insinuado sobre el borde inferior. Va después del fondo
         de hover para quedar por encima de él. -->
    <span
      aria-hidden="true"
      class="pointer-events-none absolute bottom-[12%] left-[-18%] h-[30%] w-[136%] rounded-[50%] blur-[14px]"
      style="background: radial-gradient(ellipse at 50% 55%, rgba(255,255,255,0.21) 0%, rgba(255,255,255,0.11) 42%, rgba(255,255,255,0.03) 68%, transparent 82%);"
    ></span>

    <!-- Filo del reflejo: un arco fino sobre el borde de arriba de la elipse,
         que es lo que hace que se lea como vidrio y no como una mancha. -->
    <span
      aria-hidden="true"
      class="pointer-events-none absolute bottom-[24%] left-[-10%] h-[22%] w-[120%] rounded-[50%] border-t border-white/22 blur-[3px]"
    ></span>

    <!-- Contenido -->
    <img
      alt={jugo.nombre}
      src={jugo.imagen}
      class="relative z-10 w-48 h-auto origin-top object-contain transition-transform duration-500 ease-out group-hover:scale-[1.45] group-[[data-activa]]:scale-[1.45]"
    />
  </div>
))}
</div>

  </div>
</section>

<style>
  /* Mobile: el título va en dos renglones y con 16vw. El segundo término del
     min() es el techo real — el renglón más largo mide 5.1 veces el tamaño de
     fuente y el ancho útil es 100vw menos el px-3 de los costados; el divisor
     5.3 deja margen. El tope del clamp sube a 5rem: con los 3.75rem de antes
     el 16vw quedaba frenado ahí desde los 375px de ancho para arriba, o sea
     que en la práctica no crecía nada. */
  .titulo-prod {
    font-size: clamp(1.5rem, min(16vw, (100vw - 1.5rem) / 5.3), 5rem);
    /* Interlineado corto, como el titular del hero: con el 1.5 por defecto
       los dos renglones quedaban separados por casi un renglón entero. */
    line-height: 0.9;
  }

  /* sm+: un solo renglón (el <br> se apaga) y la misma fórmula de antes. El
     tope de 3.75rem — el text-6xl original — se alcanza a los ~631px, así que
     de ahí para arriba no cambia nada respecto de lo que había. */
  @media (min-width: 640px) {
    .titulo-prod {
      font-size: clamp(1.5rem, 9.5vw, 3.75rem);
    }
  }
</style>

<script>
  // El efecto de las tarjetas (fondo que aparece + botella que crece) está
  // hecho con `group-hover`, y en una pantalla táctil no hay hover: o no pasa
  // nada, o queda pegado después del toque según el navegador. Acá el toque
  // pone un `data-activa` en la tarjeta, que dispara exactamente las mismas
  // reglas (ver `group-[[data-activa]]:` en el marcado).
  //
  // Solo se engancha donde no hay puntero fino: en desktop el hover ya hace
  // el trabajo y no hace falta que un clic deje la tarjeta encendida.
  if (window.matchMedia('(hover: none)').matches) {
    const tarjetas = Array.from(document.querySelectorAll<HTMLElement>('[data-tarjeta-prod]'));

    tarjetas.forEach((tarjeta) => {
      tarjeta.addEventListener('click', () => {
        // Nunca más de una encendida: mismo criterio que los desplegables de
        // Momento. Tocar la que ya estaba abierta la apaga.
        const yaEstaba = tarjeta.hasAttribute('data-activa');
        tarjetas.forEach((otra) => otra.removeAttribute('data-activa'));
        if (!yaEstaba) tarjeta.setAttribute('data-activa', '');
      });
    });
  }
</script>

<script>
  import gsap from 'gsap';
  import { SplitText } from 'gsap/SplitText';
  import { CustomEase } from 'gsap/CustomEase';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(SplitText, CustomEase, ScrollTrigger);

  // Misma curva que el resto de la página. Se vuelve a registrar acá (en vez
  // de asumir que Home ya la creó) para que este script no dependa de que
  // Home haya corrido antes en el documento.
  const GOLPE = CustomEase.create('golpe', 'M0,0 C1,0 0.15,1 1,1');

  const sinMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const seccion = document.querySelector<HTMLElement>('#productos');
  // La tarjeta entera (vidrio, título, botella incluida), no solo la imagen:
  // antes se veía la tarjeta ya armada y quieta con la botella apareciendo
  // sola adentro.
  const tarjetas = gsap.utils.toArray<HTMLElement>('[data-tarjeta-prod]');
  const subtitulo = document.querySelector<HTMLElement>('[data-sub-prod]');

  if (seccion && !sinMovimiento) {
    const DUR = 1;
    // Igual que en el hero: se resta de DUR, no se suma, para que el
    // escalonado de letras cierre junto con todo lo demás.
    const REPARTO = 0.2;
    // El subtítulo arranca sobre el final del título (ver más abajo), no
    // cuando termina del todo: eso lo hacía sentir desenganchado.
    const DUR_SUB = 0.35;

    // Cuánto suben las tarjetas al aparecer: bastante más que su propio alto,
    // para que arranquen desde fuera de la sección y no a mitad de camino.
    const SUBIDA_TARJETAS = () => Math.round(window.innerHeight * 0.4);

    // Estado inicial sincrónico: sin esto se ve el título/tarjetas en su
    // posición final durante el instante en que cargan las tipografías.
    gsap.set('[data-linea-prod]', { yPercent: 115 });
    gsap.set(tarjetas, { y: SUBIDA_TARJETAS, opacity: 0 });
    if (subtitulo) gsap.set(subtitulo, { opacity: 0 });

    // El hero recién arma su propio pin (que agranda el documento en varios
    // miles de px) cuando termina su entrada, hasta 4s después de cargar
    // (ver el failsafe en Home.astro). Si "top 85%"/"top 30%" se miden antes
    // de eso, quedan calculados contra un documento mucho más corto del que
    // termina siendo, y el scrub queda mapeado a un tramo de scroll que no
    // es el real (la animación arranca y cierra en cualquier punto, no
    // cuando Productos entra en pantalla). Por eso no alcanza con crear el
    // trigger y pedirle un refresh en el mismo instante: hay que esperar a
    // que el pin del hero exista de verdad.
    //
    // Se chequea el alto real del pin-spacer y no una propiedad de GSAP
    // (`scrollTrigger.pin`, `.end`): esa se pone en `true` en el mismo
    // instante en que se crea el ScrollTrigger, antes incluso de que GSAP
    // termine de medir cuánto scroll reservarle — con esa señal el chequeo
    // pasaba igual de temprano que sin él. El spacer, en cambio, es DOM real:
    // solo mide más que el hero cuando el scroll ya quedó reservado de verdad.
    const hero = document.querySelector<HTMLElement>('#home');
    const heroListo = () => {
      const spacer = document.querySelector<HTMLElement>('.pin-spacer');
      return !!(spacer && hero && spacer.offsetHeight > hero.offsetHeight * 1.5);
    };

    const armarEntrada = () => {
      // SplitText necesita medir el texto ya con la fuente cargada.
      document.fonts.ready.then(() => {
        const cortes = gsap.utils
          .toArray<HTMLElement>('[data-linea-prod]')
          // 'words,chars': sin el envoltorio por palabras, cada letra es un
          // inline-block suelto y el navegador corta la línea entre dos
          // letras cualesquiera — en pantallas angostas el título se parte al
          // medio de una palabra. `corte.chars` sigue devolviendo todas.
          .map((linea) => new SplitText(linea, { type: 'words,chars' }));

        // Mismo orden diagonal que el titular del hero.
        const letras = cortes
          .flatMap((corte) => corte.chars as HTMLElement[])
          .sort((a, b) => {
            const ra = a.getBoundingClientRect();
            const rb = b.getBoundingClientRect();
            return ra.left + ra.top - (rb.left + rb.top);
          });

        gsap.set(letras, { yPercent: 115, x: -22 });
        gsap.set('[data-linea-prod]', { yPercent: 0 });

        gsap
          .timeline({
            // Con scrub la "duration" deja de ser tiempo real y pasa a ser
            // fracción del rango de scroll (start→end): mismo mecanismo que
            // usan las transiciones del hero. GOLPE sigue siendo el default,
            // ahora mapeando avance de scroll en vez de tiempo.
            defaults: { ease: GOLPE, duration: DUR },
            scrollTrigger: {
              trigger: seccion,
              // Arranca apenas la sección asoma. GOLPE es casi plano al
              // principio, así que ese primer tramo del scroll se ve la
              // sección ya armada, sin animación perceptible — recién sobre
              // el final del recorrido pega el salto a la posición final.
              start: 'top 90%',
              end: 'top 20%',
              scrub: 0.6,
            },
          })
          .to(letras, { yPercent: 0, x: 0, duration: DUR - REPARTO, stagger: { amount: REPARTO } }, 0)
          .to(tarjetas, { y: 0, opacity: 1, stagger: { amount: 0.15 } }, 0)
          // Arranca en 0.75 (las letras terminan en DUR=1): entra mientras
          // las últimas todavía están asentando, no después de una pausa.
          // Mismo split de siempre: GOLPE para la posición, opacidad aparte
          // y lineal para que se desvanezca (aparezca) antes de llegar.
          .fromTo(subtitulo, { opacity: 0 }, { opacity: 1, duration: 0.15, ease: 'none' }, 0.75);
      });
    };

    if (heroListo()) {
      armarEntrada();
    } else {
      let listo = false;
      const espera = setInterval(() => {
        if (!heroListo()) return;
        listo = true;
        clearInterval(espera);
        armarEntrada();
      }, 100);
      // Red de seguridad: si a los 5s el spacer todavía no creció (Home sin
      // pin, error en su script, o simplemente tardó más de lo esperado), se
      // arma igual contra lo que haya en ese momento. Es mejor una medida
      // imperfecta que ninguna: sin este `else`, si `heroListo()` no se
      // cumplía nunca, la sección quedaba sin animación para siempre.
      setTimeout(() => {
        clearInterval(espera);
        if (!listo) armarEntrada();
      }, 5000);
    }
  }
</script>
