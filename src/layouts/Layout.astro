---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Imagen del preview al compartir. Ruta del sitio; se absolutiza acá. */
  imagen?: string;
  /** Para páginas que no tienen que salir en buscadores (pruebas, 404). */
  noIndexar?: boolean;
}

const {
  title = 'Savia',
  description = 'Savia',
  imagen = '/images/og.jpg',
  noIndexar = false,
} = Astro.props;

const fontUrl = "https://use.typekit.net/fam5ams.css"

// Absolutas contra `site` (astro.config.mjs). Los scrapers de WhatsApp,
// Facebook y compañía descartan las rutas relativas.
const canonica = new URL(Astro.url.pathname, Astro.site);
const imagenAbsoluta = new URL(imagen, Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/icons/isologo.svg" />
    <link rel="stylesheet" href={fontUrl} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonica} />
    {noIndexar && <meta name="robots" content="noindex, nofollow" />}

    {/* Preview al compartir el link (WhatsApp, Instagram, Slack, Facebook). */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Savia" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:url" content={canonica} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imagenAbsoluta} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={description} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imagenAbsoluta} />
    <script is:inline>
      // Al recargar, el navegador restaura la posición de scroll anterior y la
      // página aparecería en mitad de la animación. Va en el <head> y sin
      // defer: tiene que correr antes de que el navegador restaure.
      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
      window.addEventListener('load', function () {
        window.scrollTo(0, 0);
      });

      // Red de seguridad. El hero arranca con visibility:hidden y lo destapa
      // el script de la animación; si ese módulo falla o no carga, la página
      // quedaría en blanco. A los 2s se muestra igual.
      setTimeout(function () {
        document.documentElement.setAttribute('data-listo', '');
      }, 2000);
    </script>
  </head>
  <body class="min-h-dvh ">
    <slot />
  </body>
</html>

